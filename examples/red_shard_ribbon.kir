// A few thousand thin solid red chips strung along one long winding path that
// loops round the origin several times. Along its length the path twists about
// one axis, sits off the origin, swings about a second axis a number of times
// that drifts slowly with time, and bows outward in the middle. The chips slide
// along it and wrap from the end back to the start, so the ribbon flows while
// its knot slowly tightens and loosens.
//
// Each chip is a cube squashed by its own random amounts into a shard. Its size
// and roll follow one of six sound levels picked at random, so quiet levels
// shrink their chips to nothing and the ribbon thins to a dotted trail; past a
// threshold a chip turns electric blue-white.
//
// Each chip is 12 triangles, 36 elements: element `seed` is corner `seed % 3`
// of triangle `(seed % 36) / 3` of chip `seed / 36`.
//
//     cargo run -p karakuri-cli -- --take-in examples/red_shard_ribbon.kset
//     cargo run -p karakuri-cli -- --load-set red_shard_ribbon

proc red_shard_ribbon {
  kind     L1
  topology triangles
  capacity [9216, 294912] = 110592   // 3072 chips * 36 corners

  // Radius of the loops round the origin, and how far the middle bows out.
  param radius : float [0.2, 6.0] = 2.2
  param bow    : float [0.0, 2.0] = 0.45

  // Loops round the origin over the whole path, and twists about its own axis.
  param loops  : float [1.0, 8.0] = 3.0
  param twist  : float [0.0, 8.0] = 2.0

  // Offset of the path from the origin before it is twisted.
  param offset : float [0.0, 3.0] = 0.9

  // Path lengths travelled per second.
  param flow   : float [-0.2, 0.2] = 0.012

  // Largest chip, in world units, and the level above which a chip flashes.
  param chip   : float [0.02, 1.0] = 0.4
  param peak   : float [0.0, 1.0] = 0.8

  // Six sound levels in 0..1; each chip listens to one of them.
  param low    : vec3 [0.0, 1.0] = vec3(0.5, 0.5, 0.5)
  param high   : vec3 [0.0, 1.0] = vec3(0.5, 0.5, 0.5)

  emit position, tint

  element {
    let body   = seed / 36u;
    let rem    = seed % 36u;
    let face   = rem / 6u;
    let tri    = (rem % 6u) / 3u;
    let corner = rem % 3u;

    // The corner on the face square, u and v in {-1, 1}: triangle 0 is
    // corners 0,1,2 of the square and triangle 1 is corners 0,2,3.
    var q = corner;
    if tri == 1u && corner > 0u {
      q = corner + 1u;
    }
    var u = -1.0;
    var v = -1.0;
    if q == 1u || q == 2u {
      u = 1.0;
    }
    if q >= 2u {
      v = 1.0;
    }
    let side = float(face % 2u) * 2.0 - 1.0;
    var local = vec3(side, u, v);
    if face / 2u == 1u {
      local = vec3(v, side, u);
    }
    if face / 2u == 2u {
      local = vec3(u, v, side);
    }

    // Which of the six levels this chip hears.
    let pick = uint(hash1(body * 5u + 1u) * 6.0);
    var level = low.x;
    if pick == 1u { level = low.y; }
    if pick == 2u { level = low.z; }
    if pick == 3u { level = high.x; }
    if pick == 4u { level = high.y; }
    if pick == 5u { level = high.z; }

    // The shard: squashed by its own amounts, turned at random, rolled by level.
    let squash = vec3(1.0, 0.12 + 0.3 * hash1(body * 5u + 2u), 0.3 + 0.7 * hash1(body * 5u + 3u));
    let aim    = hash3(body * 5u + 4u) * 6.2831853;
    let shard  = rot_x(local * 0.5 * squash * chip * level, aim.x + level * 4.0);
    let turned = rot_z(rot_y(shard, aim.y), aim.z);

    // Where on the path, 0..1 from start to end, sliding and wrapping.
    let n  = float(capacity / 36u);
    let s  = fract(float(body) / n + hash1(body * 5u + 5u) * 0.6 / n + t * flow);
    let r  = radius * (1.0 + bow * sin(s * 3.1415927));
    let swings = 2.0 + 1.5 * sin(t * 0.04);
    var p  = rot_x(vec3(r, offset, 0.0), s * 6.2831853 * twist);
    p      = rot_y(p, s * 6.2831853 * loops);
    p      = rot_z(p, sin(s * 6.2831853 * swings) * 0.6);

    let flash = smoothstep(peak, 1.0, level);
    let red   = vec3(0.85, 0.02, 0.03);
    let ice   = vec3(0.5, 0.75, 1.0) * 4.0;

    position = p + turned;
    tint     = mix(red, ice, vec3(flash));
  }
}
