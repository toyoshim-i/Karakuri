// Eight soft blobs wandering the frame on slow looping paths and melting into
// one another where they meet, like wax in a lava lamp. Each blob carries its
// own hue and the merged body blends them by influence; a bright rim traces the
// surface and faint contour lines ring it on the outside. Draws the whole frame
// and reads no geometry; a camera looking at the origin sets the frame's aspect.
//
//     cargo run -p karakuri-cli -- --set examples/step_grid.kir,examples/meta_blobs.kir

proc meta_blobs {
  kind  L4
  blend additive

  // Radius of one blob on its own, as a fraction of the frame's half-height.
  param radius   : float [0.05, 0.6] = 0.22

  // Extra radius added to every blob; for an audio binding.
  param swell    : float [0.0, 0.3] = 0.0

  // Speed along the paths.
  param pace     : float [0.0, 3.0] = 0.35

  // Hue of the first blob; the others step round the wheel from it.
  param hue      : float [0.0, 1.0] = 0.9

  // Spread of the blobs' hues round the wheel.
  param spread   : float [0.0, 1.0] = 0.45

  // Brightness of the contour lines outside the surface.
  param rings    : float [0.0, 1.0] = 0.25

  // Brightness multiplier.
  param exposure : float [0.0, 4.0] = 1.0

  fragment {
    let fw  = normalize(-eye);
    let rt  = normalize(cross(fw, vec3(0.0, 1.0, 0.0)));
    let upv = cross(rt, fw);
    let sc  = vec2(dot(ray, rt), dot(ray, upv)) / (dot(ray, fw) * 0.57735);

    let r2 = (radius + swell) * (radius + swell);
    var fld = 0.0;
    var hw  = vec3(0.0);
    for i in 0..8 {
      let fi = float(i);
      let s  = t * pace;
      let c  = vec2(sin(s * (0.61 + fi * 0.13) + fi * 2.1) * 1.3,
                    cos(s * (0.47 + fi * 0.11) + fi * 1.3) * 0.75);
      let dd = sc - c;
      let w  = r2 / max(dot(dd, dd), 0.00001);
      fld += w;
      hw  += hsv_to_rgb(vec3(fract(hue + spread * fi / 8.0), 0.85, 1.0)) * w;
    }
    let tint_mix = hw / max(fld, 0.00001);

    // `fld` is 1 on the surface.
    let body  = smoothstep(0.95, 1.05, fld);
    let core  = smoothstep(1.0, 4.0, fld);
    let rim   = exp(-abs(fld - 1.0) * 14.0);
    let lines = pow(0.5 + 0.5 * cos(log2(max(fld, 0.0001)) * 12.0 - t * 2.0), 8.0)
              * (1.0 - body) * smoothstep(0.08, 0.5, fld);

    let l = body * (0.25 + 0.5 * core) + rim * 1.2 + lines * rings;
    color = vec4(tint_mix * l * exposure, 1.0);
  }
}
