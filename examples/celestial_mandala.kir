// An intricate sacred geometry mandala projected across the celestial dome.
// At the zenith (center), a glowing Merkabah star and multi-tiered lotus petals
// rotate in harmonic opposition, expanding outward into Flower of Life rings,
// concentric dashed astronomical dials, and an azimuth compass along the horizon.
//
// Designed for the WebXR Built-in VR Dome & Kaleidosky projections (docs/vr-projection.md):
// - `point_coord` (0.5, 0.5) is the zenith directly overhead.
// - Radius ~0.75 is the astronomical horizon, with a soft fade down to 1.0 (-30 deg).
// - In `Dome` mode, creates an awe-inspiring sacred canopy above the performer.
// - In `Kaleidosky` mode, unfolds into an infinite kaleidoscopic temple of light.
//
//     cargo run -p karakuri -- examples/halo_points.kir examples/celestial_mandala.kir

proc celestial_mandala {
  kind  L4
  blend additive

  // Base rotation speed of the primary mandala rings.
  param spin    : float [0.0, 2.0]    = 0.3

  // Number of radial petals in the central lotus core (floored to integer).
  param petals  : float [4.0, 24.0]   = 12.0

  // Angular scale of the central lotus (radius in dome space).
  param scale   : float [0.1, 0.8]    = 0.38

  // Brightness of the sacred geometry lines and rings.
  param glow    : float [0.0, 4.0]    = 1.4

  // Primary gold color tint for the core geometries.
  param gold    : vec3  [0.0, 2.0]    = vec3(1.0, 0.78, 0.36)

  // Secondary azure/cyan tint for the outer celestial astrolabe.
  param azure   : vec3  [0.0, 2.0]    = vec3(0.25, 0.75, 1.0)

  // Audio swell pulse: expands concentric shockwave rings from the zenith.
  param pulse   : float [0.0, 2.0]    = 0.0

  // Horizon twilight glow intensity.
  param dusk    : float [0.0, 1.0]    = 0.2

  fragment {
    // ---- Polar coordinate transform relative to Zenith (0.5, 0.5) --------
    let p  = point_coord * 2.0 - vec2(1.0);
    let r  = length(p);
    let az = atan2(p.x, p.y + 0.000001);

    // Dynamic anti-aliasing width
    let aa = fwidth(r) * 1.8 + 0.003;

    // ---- Harmonic rotation angles ----------------------------------------
    let sp = t * spin * 0.2 + beats * 0.05;
    let a1 = az + sp;
    let a2 = az - sp * 0.75;
    let a3 = az + sp * 1.5;

    // Normalized radial distance relative to lotus scale
    let zr = r / scale;
    let n  = floor(petals);

    // ---- 1. Zenith Core: Pulsing Merkabah & Multi-tiered Lotus ------------
    // Inner 6-point / N-point star
    let star_r = 0.18 + 0.08 * cos(a3 * 6.0);
    let star_line = 1.0 - smoothstep(0.0, aa * 3.0, abs(zr - star_r));

    // Counter-rotating 12-petal lotus rings
    let petal1 = 0.45 + 0.25 * abs(cos(a1 * (n * 0.5)));
    let petal2 = 0.75 + 0.20 * abs(cos(a2 * n));
    let line1  = 1.0 - smoothstep(0.0, aa * 2.5, abs(zr - petal1));
    let line2  = 1.0 - smoothstep(0.0, aa * 2.5, abs(zr - petal2));

    // Central radiant core at the exact zenith
    let core_glow = exp(-zr * zr * 32.0) * (1.2 + 0.8 * sin(t * 3.0 + pulse * 4.0));

    // ---- 2. Mid-Sky: Concentric Astrolabe Dials & Dashed Rings -------------
    // Flower of life harmonic rings at specific sacred radii
    let ring1 = 1.0 - smoothstep(0.0, aa, abs(zr - 1.0));
    let ring2 = 1.0 - smoothstep(0.0, aa, abs(zr - 1.25));

    // Dashed tick-mark dials
    let dashes1 = step(0.4, fract(a1 * n * 2.0 / 6.2831853));
    let dashes2 = step(0.3, fract(a2 * n * 4.0 / 6.2831853));
    let dial1   = (1.0 - smoothstep(0.0, aa, abs(zr - 1.4))) * dashes1;
    let dial2   = (1.0 - smoothstep(0.0, aa, abs(zr - 1.6))) * dashes2;

    // Pulse shockwave expanding from zenith to horizon
    let shock_phase = fract(t * 0.4 + pulse * 0.5 - r * 0.8);
    let shock = smoothstep(0.08, 0.0, abs(shock_phase - 0.5)) * exp(-r * 1.5) * (1.0 + pulse * 2.0);

    // Assemble inner lotus & mid-sky structures
    let inner_mask = 1.0 - smoothstep(1.7, 2.0, zr);
    let inner_geom = (star_line * 0.8 + line1 + line2 * 0.8 + ring1 + ring2 * 0.7 + dial1 + dial2 + core_glow) * inner_mask;

    // ---- 3. Outer Horizon: Astrolabe Compass & Azimuth Rays ---------------
    // Astronomical horizon circle at r ~ 0.75 (elevation 0 deg)
    let horiz_ring = 1.0 - smoothstep(0.0, aa * 1.5, abs(r - 0.75));
    // Fine azimuth degree ticks (72 divisions around the horizon)
    let az_ticks   = step(0.65, fract(az * 36.0 / 6.2831853));
    let horiz_sub  = (1.0 - smoothstep(0.0, aa, abs(r - 0.72))) * az_ticks;

    // Cardinal rays projecting from mid-sky to horizon
    let ray_count  = 24.0;
    let rays       = pow(0.5 + 0.5 * cos(az * ray_count + sp * 0.5), 16.0);
    let ray_fade   = smoothstep(0.3, 0.7, r) * (1.0 - smoothstep(0.76, 0.85, r));
    let horiz_rays = rays * ray_fade * 0.6;

    // Twilight horizon base glow
    let twilight = exp(-abs(r - 0.75) * 6.0) * dusk;

    // ---- 4. Color Compositing & Horizon Soft Fade -------------------------
    let col_core  = mix(gold, azure, vec3(smoothstep(0.2, 0.8, r)));
    let col_outer = mix(azure, gold, vec3(smoothstep(0.6, 0.8, r)));

    var rgb = col_core * (inner_geom + shock * 0.5)
            + col_outer * (horiz_ring * 0.9 + horiz_sub * 0.7 + horiz_rays)
            + vec3(0.05, 0.08, 0.18) * twilight;

    rgb = rgb * glow;

    // Soft rim falloff 30 deg below horizon (r = 0.92 to 1.0)
    let rim = 1.0 - smoothstep(0.92, 1.0, r);
    color = vec4(rgb * rim, 1.0);
  }
}
