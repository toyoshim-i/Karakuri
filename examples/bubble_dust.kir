// A drifting cloud of fine dust, each mote wandering on its own sum of sines,
// carved by a lattice of invisible spheres that push the motes out onto their
// surfaces, so bubble shells open and close as the cloud flows through them.
//
//     cargo run -p karakuri-cli -- --set examples/bubble_dust.kir,examples/halo_points.kir

proc bubble_dust {
  kind     L1
  topology points
  capacity [4096, 524288] = 65536

  // Radians per second of each mote's wandering, and of the lattice's drift
  // through the cloud in lattice cells per second.
  param speed   : float [0.0, 1.0]  = 0.18
  param drift   : float [0.0, 1.0]  = 0.12

  // Distance between neighbouring sphere centres, in world units.
  param spacing : float [0.4, 3.0]  = 1.7

  // How far a mote inside a sphere is moved toward its surface: 0 leaves the
  // cloud uncarved, 1 puts every mote inside a sphere on its shell.
  param push    : float [0.0, 1.0]  = 1.0

  // Radius of the cloud in world units.
  param cloud   : float [0.5, 4.0]  = 2.6

  // Strength of the pastel tint taken from the direction a mote was pushed.
  param pastel  : float [0.0, 1.0]  = 0.45

  // Brightness of every mote.
  param bright  : float [0.0, 2.0]  = 0.12

  emit position, tint

  element {
    let h0 = hash3(seed);
    let h1 = hash3(seed + 7919u);
    let h2 = hash3(seed + 15731u);

    // A home inside a ball, and a wander of three incommensurate sines.
    let home = sphere_point(h0.x, h0.y) * pow(h0.z, 0.4) * cloud;
    let f    = vec3(0.6) + h1 * 0.9;
    let ph   = h2 * 6.2831853;
    let s    = t * speed;
    let w    = vec3(sin(s * f.x + ph.x) + 0.5 * sin(s * f.y * 1.7 + ph.z),
                    sin(s * f.y + ph.y) + 0.5 * sin(s * f.z * 1.3 + ph.x),
                    sin(s * f.z + ph.z) + 0.5 * sin(s * f.x * 1.9 + ph.y));
    let p    = home + w * cloud * 0.35;

    // The lattice slides through the cloud along a slowly turning direction.
    let dir = normalize(vec3(cos(t * 0.05), 0.35, sin(t * 0.05)));
    let q   = p / spacing + dir * t * drift;
    let c   = floor(q + vec3(0.5));
    let l   = q - c;

    // Each cell's sphere breathes at its own phase.
    let key = uint(int(c.x) + 4096) * 73856093u + uint(int(c.y) + 4096) * 19349663u + uint(int(c.z) + 4096) * 83492791u;
    let rad = 0.36 + 0.1 * sin(t * 0.4 + hash1(key) * 6.2831853);
    let d   = length(l);

    var out = l;
    var hit = 0.0;
    if d < rad && d > 0.0001 {
      out = l / d * mix(d, rad, push);
      hit = 1.0;
    }

    position = (c + out - dir * t * drift) * spacing;

    let n   = l / max(d, 0.0001);
    let pal = mix(vec3(1.0), vec3(0.55) + n * 0.45, vec3(pastel * hit));
    tint = pal * bright * (0.3 + 1.2 * hit);
  }
}
