// df_smoky_post (`L5`) — Continuous fluorescent halation, volumetric smoke veil, and dark vignette.
//
// Locked to the exact 8.0-second loop (`fract(t * 0.125)`). Uses a tight overlapping
// kernel (`frame_step(0.0015 * rad)`) for silky halation with zero tap-grid artifacts,
// layered with 3D-looping fbm club smoke and dark gallery room vignetting.

proc df_smoky_post {
  kind L5

  param bloom    : float [0.0, 6.0] = 1.65
  param knee     : float [0.0, 1.5] = 0.35
  param radius   : float [0.5, 4.0] = 1.45
  param smoke    : float [0.0, 2.0] = 0.95
  param vignette : float [0.0, 1.5] = 0.72

  param sub_bass  : float [0.0, 2.0] = 0.45
  param transient : float [0.0, 2.0] = 0.35

  frame {
    let p      = point_coord;
    let loop_u = fract(t * 0.125);
    let a      = loop_u * 6.2831853;
    let b16    = loop_u * 16.0;

    let beat_hit = pow(1.0 - fract(b16), 3.5);
    let kick     = clamp(sub_bass * 0.6 + beat_hit * 0.55, 0.0, 2.0);
    let zero3    = vec3(0.0);

    let centre = tap(src, p);
    let rad    = radius * (1.0 + 0.12 * kick);
    let d      = frame_step(0.0015 * rad);
    let knee3  = vec3(knee);

    // Tightly overlapping 5x5 Gaussian halation (no discrete grid separation)
    var halo = vec3(0.0);
    for i in -2..3 {
      let fi = float(i);
      let wi = exp(fi * fi * -0.32);
      for j in -2..3 {
        let fj = float(j);
        let wj = wi * exp(fj * fj * -0.32);
        let sm = tap(src, clamp(p + vec2(fi * d.x, fj * d.y), vec2(0.001), vec2(0.999)));
        halo = halo + wj * max(sm.xyz - knee3, zero3);
      }
    }

    let glow_col = halo * 0.055 * bloom * (0.90 + 0.22 * kick);

    // Drifting screen-space smoke veil on a closed 8-second circular path
    let s1 = fbm(vec3(p.x * 2.2 + 0.45 * cos(a), p.y * 1.8 + 0.45 * sin(a), 0.40 * sin(a - 0.8)), 3);
    let s2 = fbm(vec3(p.x * 4.5 - 0.35 * sin(a * 2.0), p.y * 3.8 + 0.35 * cos(a * 2.0), 1.7 + 0.40 * cos(a)), 3);
    let mist = clamp(s1 * 0.72 + s2 * 0.42 + 0.28, 0.0, 1.5);

    // Smoke scatters the local colored fluorescent light and adds a subtle dark-room atmospheric veil
    let amb_smoke = mix(vec3(0.04, 0.015, 0.035), vec3(0.015, 0.035, 0.05), vec3(p.x)) * mist * smoke * 0.85;
    let lit_smoke = (glow_col * 0.75 + centre.xyz * 0.22) * mist * smoke;

    var outc = centre.xyz * (1.0 - 0.18 * mist * smoke) + glow_col + lit_smoke + amb_smoke;

    // Dark smoky room corner vignette
    let dv = (p - vec2(0.5, 0.5)) * vec2(1.18, 1.0);
    let vg = 1.0 - vignette * clamp(dot(dv, dv) * 1.95, 0.0, 0.94);
    outc = outc * vg;

    color = vec4(outc, centre.w);
  }
}
