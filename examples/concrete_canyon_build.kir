// concrete_canyon_build (`L1`, topology lines) — 8-bar seamless warehouse canyon.
//
// Time source is `beats` ONLY. Over 8 bars (32 beats) every phase returns to
// its start exactly: all sinusoids are integer harmonics of a = beats * 2*pi/32,
// and every stream term is fract(const + beats * k) with k*32 an integer.
// Nothing reads `t`, so the render loops seamlessly on the bar-8 downbeat.

proc concrete_canyon_build {
  kind L1
  topology lines
  capacity [12288, 131072] = 12288

  param scroll    : float [0.0, 3.0] = 1.00
  param build     : float [0.0, 2.0] = 1.00
  param density   : float [0.0, 1.0] = 0.72
  param glow      : float [0.2, 3.0] = 1.30

  param sub_bass  : float [0.0, 2.0] = 0.45
  param low_mid   : float [0.0, 2.0] = 0.50
  param high_mid  : float [0.0, 2.0] = 0.45
  param high_air  : float [0.0, 2.0] = 0.45
  param transient : float [0.0, 2.0] = 0.35

  emit position, velocity, tint, size

  element {
    let a  = beats * 0.19634954084936207;
    let beat_hit = pow(1.0 - fract(beats), 3.5);
    let kick  = clamp(sub_bass * 0.85 + beat_hit * 0.40, 0.0, 2.0);
    let air   = clamp(high_air * 0.95, 0.0, 2.0);
    let flash = clamp(transient * 1.10 + beat_hit * 0.30, 0.0, 2.0);
    // downbeat of bar 1: one short, hard lift, gone by bar 2.
    let oh = pow(1.0 - fract(beats * 0.03125), 8.0);

    // 8-bar arc: the canyon stands low at bar 1, tall through bars 4-6, settles by bar 8.
    let arc  = smoothstep(0.0, 1.0, 0.5 - 0.5 * cos(a));
    let grow = 0.45 + 0.55 * arc;

    let S = max(round(scroll), 0.0);
    let travel = beats * 0.5 * S;

    let ZFAR = -70.0;
    let RANGE = 86.0;
    let MOD = 5.375;
    let WX = 7.0;
    let YT = 8.0;

    var p0  = vec3(0.0);
    var p1  = vec3(0.0);
    var col = vec3(0.0);
    var wid = 1.0;

    if seed < 4096u {
      // ---------------------------------------------------------------- A: facades
      let s    = seed;
      let m    = s / 256u;
      let r    = s % 256u;
      let side = r / 128u;
      let k    = r % 128u;

      let u  = (float(m) + 0.5) * 0.0625;
      let zc = ZFAR + fract(u + travel) * RANGE;
      let z0 = zc - MOD;
      let sx = mix(-WX, WX, float(side));

      let hb  = hash1(m * 17u + side * 251u + 3u);
      let hph = 0.5 + 0.5 * sin(a - hb * 6.2831853);
      let hgt = clamp((1.0 + 5.2 * hb) * grow * (0.40 + 0.60 * hph) * (0.55 + 0.45 * build), 0.25, 11.0);

      let fog = clamp(exp(zc * 0.026), 0.05, 1.0);
      let nf  = 1.0 - smoothstep(9.0, 15.0, zc);
      let ff  = smoothstep(ZFAR, ZFAR + 26.0, zc);
      let vig = nf * ff * fog;
      let pulse = 1.0 + 0.55 * flash + 0.35 * kick + 1.10 * oh;
      let body  = 0.85 + 0.45 * hb;
      var lit = 1.0;

      if k < 4u {
        // concrete-block silhouette: base rail, top rail, two vertical edges
        if k == 0u {
          p0 = vec3(sx, 0.0, z0);
          p1 = vec3(sx, 0.0, zc);
        } else {
          if k == 1u {
            p0 = vec3(sx, hgt, z0);
            p1 = vec3(sx, hgt, zc);
          } else {
            if k == 2u {
              p0 = vec3(sx, 0.0, z0);
              p1 = vec3(sx, hgt, z0);
            } else {
              p0 = vec3(sx, 0.0, zc);
              p1 = vec3(sx, hgt, zc);
            }
          }
        }
        col = vec3(0.11, 0.66, 0.92) * body;
        lit = 1.0;
      } else {
        if k < 20u {
          // 4 x 4 window grid inside the block
          let kw  = k - 4u;
          let ccl = kw % 4u;
          let crw = kw / 4u;
          let zz  = mix(z0, zc, (float(ccl) + 0.5) * 0.25);
          let yy  = hgt * (float(crw) + 1.0) * 0.20;
          let dsh = MOD * 0.055;
          p0 = vec3(sx, yy, zz - dsh);
          p1 = vec3(sx, yy, zz + dsh);

          let win   = hash1(m * 131u + ccl * 97u + crw * 7u + 5u);
          let blink = step(0.66 - density * 0.26, sin(a * 11.0 + win * 6.2831853));
          let dawn  = step(0.86 - density * 0.16, sin(a * 3.0 + win * 6.2831853));
          lit = max(blink * 0.90, dawn * 0.30);

          if win < 0.28 {
            col = vec3(1.60, 0.30, 0.86);
          } else {
            if win > 0.72 {
              col = vec3(1.85, 0.92, 0.34);
            } else {
              col = vec3(0.26, 1.15, 1.35);
            }
          }
        } else {
          p0 = vec3(0.0, 0.0, 0.0);
          p1 = vec3(0.0, 0.0, 0.0);
          col = vec3(0.0, 0.0, 0.0);
          lit = 0.0;
        }
      }
      col = col * lit * vig * glow * pulse;
      wid = 0.45 + 0.55 * fog;

    } else {
      if seed < 5120u {
        // ----------------------------------------- B: floor, ceiling, lamps, marks
        let s = seed - 4096u;
        let m = s / 64u;
        let k = s % 64u;
        let u  = (float(m) + 0.5) * 0.0625;
        let zc = ZFAR + fract(u + travel) * RANGE;
        let z0 = zc - MOD;

        let fog = clamp(exp(zc * 0.026), 0.05, 1.0);
        let nf  = 1.0 - smoothstep(-2.0, 10.0, zc);
        let ff  = smoothstep(ZFAR, ZFAR + 34.0, zc);
        let vig = nf * ff * fog * (1.0 + 0.45 * oh);
        var w2 = 0.55 + 0.45 * fog;

        if k == 0u {
          p0 = vec3(-WX, 0.0, zc);
          p1 = vec3(WX, 0.0, zc);
          col = vec3(0.07, 0.50, 0.66);
        } else {
          if k < 4u {
            // three ground lanes
            let x = -WX + float(k - 1u) * WX;
            p0 = vec3(x, 0.0, z0);
            p1 = vec3(x, 0.0, zc);
            col = vec3(0.05, 0.36, 0.48);
          } else {
            if k == 4u {
              p0 = vec3(-WX, YT, zc);
              p1 = vec3(WX, YT, zc);
              col = vec3(0.05, 0.36, 0.48);
            } else {
              if k < 8u {
                let x = -WX + float(k - 5u) * WX;
                p0 = vec3(x, YT, z0);
                p1 = vec3(x, YT, zc);
                col = vec3(0.04, 0.28, 0.38);
              } else {
                if k < 10u {
                  // hanging lamp + shaft, one per module
                  let lx = mix(-4.4, 4.4, hash1(m * 53u + 7u));
                  let lz = zc - MOD * 0.5;
                  let ly = YT - 0.85 - 0.9 * hash1(m * 29u + 7u);
                  if k == 8u {
                    p0 = vec3(lx, YT, lz);
                    p1 = vec3(lx, ly, lz);
                    col = vec3(2.10, 1.65, 0.95) * (0.70 + 0.80 * kick);
                    w2 = 1.20;
                  } else {
                    p0 = vec3(lx, ly, lz);
                    p1 = vec3(lx, 0.0, lz);
                    col = vec3(0.30, 0.40, 0.52) * (0.50 + 0.90 * kick);
                    w2 = 1.70;
                  }
                } else {
                  if k < 34u {
                    // sparse inlane markers: 3 lanes x 8 dashes
                    let li = k - 10u;
                    let x  = -WX + float(li % 3u) * WX;
                    let zz = mix(z0, zc, (float(li / 3u) + 0.5) * 0.125);
                    let d  = MOD * 0.045;
                    let mk = step(0.78, hash1(m * 71u + li + (uint(floor(beats * 2.0)) % 64u) * 13u));
                    p0 = vec3(x, 0.0, zz - d);
                    p1 = vec3(x, 0.0, zz + d);
                    col = vec3(0.40, 0.95, 1.15) * mk;
                    w2 = 1.30;
                  } else {
                    p0 = vec3(0.0, 0.0, 0.0);
                    p1 = vec3(0.0, 0.0, 0.0);
                    col = vec3(0.0, 0.0, 0.0);
                    w2 = 0.0;
                  }
                }
              }
            }
          }
        }
        col = col * vig * glow;
        wid = w2;

      } else {
        if seed < 9216u {
          // ------------------------------------------------------- C: data rain
          let s   = seed - 5120u;
          let cid = s / 8u;
          let seg = s % 8u;
          let hx  = hash1(cid * 37u + 1u);
          let hz  = hash1(cid * 71u + 5u);
          let hsp = hash1(cid * 113u + 9u);
          let alive = step(0.72, hash1(cid * 271u + 3u));

          let x  = -WX + hx * (2.0 * WX);
          let zc = ZFAR + fract(hz + beats * 0.125) * RANGE;
          let fy = fract(hsp + beats * 0.75);
          let y0 = YT * (1.0 - fy) + 0.2 + float(seg) * 0.19;
          let y1 = y0 + 0.19;

          p0 = vec3(x, min(y0, YT + 0.5), zc);
          p1 = vec3(x, min(y1, YT + 0.5), zc);

          let tail = pow(1.0 - float(seg) * 0.125, 1.7);
          let nf   = 1.0 - smoothstep(6.0, 16.0, zc);
          let vis  = tail * nf * alive * clamp(exp(zc * 0.020), 0.10, 1.0) * (0.40 + 0.50 * air + 0.30 * flash) * (1.0 + 0.35 * oh);
          if hz > 0.93 {
            col = vec3(1.30, 0.28, 0.75) * vis;
          } else {
            col = vec3(0.18, 0.95, 0.72) * vis;
          }
          col = col * glow;
          wid = 0.45;

        } else {
          if seed < 11264u {
            // -------------------------------------------------- D: roof signage
            let s    = seed - 9216u;
            let m    = s / 128u;
            let r    = s % 128u;
            let side = r / 64u;
            let k    = r % 64u;

            let u  = (float(m) + 0.5) * 0.0625;
            let zc = ZFAR + fract(u + travel) * RANGE;
            let z0 = zc - MOD;
            let sx = mix(-WX, WX, float(side));

            let hb  = hash1(m * 17u + side * 251u + 3u);
            let hph = 0.5 + 0.5 * sin(a - hb * 6.2831853);
            let hgt = clamp((1.0 + 5.2 * hb) * grow * (0.40 + 0.60 * hph) * (0.55 + 0.45 * build), 0.25, 11.0);

            let fog = clamp(exp(zc * 0.026), 0.05, 1.0);
            let nf  = 1.0 - smoothstep(9.0, 15.0, zc);
            let ff  = smoothstep(ZFAR, ZFAR + 26.0, zc);
            let vig = nf * ff * fog;

            if k == 0u {
              let ah = 0.5 + 1.6 * hash1(m * 19u + side * 37u);
              p0 = vec3(sx, hgt, z0 + MOD * 0.30);
              p1 = vec3(sx, hgt + ah, z0 + MOD * 0.30);
              col = vec3(0.60, 0.80, 0.95) * vig * glow * 0.8;
              wid = 0.7;
            } else {
              if k == 1u {
                let ah = 0.5 + 1.6 * hash1(m * 19u + side * 37u);
                let by = hgt + ah;
                let bk = step(0.5, sin(a * 8.0 + float(m) * 0.9 + float(side) * 2.1));
                p0 = vec3(sx, by - 0.11, z0 + MOD * 0.30);
                p1 = vec3(sx, by + 0.11, z0 + MOD * 0.30);
                col = vec3(2.00, 0.28, 0.32) * bk * vig * glow;
                wid = 1.0;
              } else {
                if k < 6u {
                  let cyy = hgt + 0.95;
                  let czz = z0 + MOD * 0.5;
                  if k == 2u {
                    p0 = vec3(sx, cyy - 1.05, czz - 0.85);
                    p1 = vec3(sx, cyy - 1.05, czz + 0.85);
                  } else {
                    if k == 3u {
                      p0 = vec3(sx, cyy + 1.05, czz - 0.85);
                      p1 = vec3(sx, cyy + 1.05, czz + 0.85);
                    } else {
                      if k == 4u {
                        p0 = vec3(sx, cyy - 1.05, czz - 0.85);
                        p1 = vec3(sx, cyy + 1.05, czz - 0.85);
                      } else {
                        p0 = vec3(sx, cyy - 1.05, czz + 0.85);
                        p1 = vec3(sx, cyy + 1.05, czz + 0.85);
                      }
                    }
                  }
                  col = vec3(0.85, 0.22, 1.20) * vig * glow * (0.50 + 0.70 * flash);
                  wid = 0.8;
                } else {
                  if k < 62u {
                    let li  = k - 6u;
                    let gc  = li % 8u;
                    let gr  = li / 8u;
                    let on  = step(0.45, fract(float(gc) * 0.13 - beats * 0.25) + hash1(li * 31u + m * 7u) * 0.20);
                    let yy  = hgt + 0.05 + float(gr) * 0.28;
                    let zz  = z0 + MOD * 0.5 - 0.75 + (float(gc) + 0.5) * 0.20;
                    p0 = vec3(sx, yy, zz - 0.06);
                    p1 = vec3(sx, yy, zz + 0.06);
                    col = vec3(1.35, 0.50, 1.60) * on * vig * glow * (0.60 + 0.50 * flash);
                    wid = 0.8;
                  } else {
                    p0 = vec3(0.0, 0.0, 0.0);
                    p1 = vec3(0.0, 0.0, 0.0);
                    col = vec3(0.0, 0.0, 0.0);
                    wid = 0.0;
                  }
                }
              }
            }

          } else {
            // ---------------------------------------------------- E: smoke motes
            let s   = seed - 11264u;
            let hx  = hash1(s * 13u + 1u);
            let hy  = hash1(s * 29u + 3u);
            let hz  = hash1(s * 53u + 7u);
            let dr  = 0.02 + 0.05 * hash1(s * 97u + 5u);
            let x   = -WX + hx * (2.0 * WX);
            let y   = 0.25 + hy * (YT - 0.5);
            let zc  = ZFAR + hz * RANGE;
            let sw  = 0.35 * sin(a * 2.0 + hy * 6.2831853);
            let vis = (0.30 + 0.60 * air) * clamp(exp(zc * 0.018), 0.05, 1.0) * (1.0 - smoothstep(6.0, 16.0, zc));
            p0 = vec3(x + sw, y, zc);
            p1 = vec3(x + sw, y + dr, zc);
            col = vec3(0.45, 0.62, 0.82) * vis * glow * 0.50;
            wid = 0.9;
          }
        }
      }
    }

    position = p0;
    velocity = p0 - p1;
    tint = col;
    size = wid;
  }
}
