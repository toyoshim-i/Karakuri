// df_room_cam (`L3`) — Exact 8-second looping camera in a dark smoky gallery room.
//
// Period is locked to 8.0 seconds (`fract(t * 0.125)`), with 16 techno beats per
// 8-second loop (120 BPM). Glides in a slow figure-eight so the corner barriers,
// wall monuments, cute fluorescent centerpiece, and glossy floor reflections
// shift in parallax and return seamlessly at t = 8.0s.

proc df_room_cam {
  kind L3

  param dist     : float [1.0, 8.0]  = 2.20
  param sway     : float [0.0, 2.5]  = 1.15
  param look_y   : float [0.5, 4.5]  = 2.35
  param base_fov : float [0.6, 1.8]  = 1.08
  param bank     : float [0.0, 1.0]  = 0.18
  param punch    : float [0.0, 1.0]  = 0.12

  param sub_bass  : float [0.0, 2.0] = 0.45
  param transient : float [0.0, 2.0] = 0.35

  camera {
    let loop_u = fract(t * 0.125);
    let a      = loop_u * 6.2831853;
    let a2     = a * 2.0;
    let b16    = loop_u * 16.0;

    let beat_hit = pow(1.0 - fract(b16), 4.0);
    let kick     = clamp(sub_bass * 0.5 + beat_hit * 0.6, 0.0, 2.0);

    let ex = sway * 1.15 * sin(a);
    let ey = 2.15 + sway * 0.28 * sin(a2 + 0.6);
    let ez = dist - sway * 0.85 * cos(a);

    let tx = sway * 0.42 * sin(a - 0.55);
    let ty = look_y + sway * 0.18 * cos(a2) + 0.06 * beat_hit;
    let tz = -8.50;

    let fwd   = normalize(vec3(tx - ex, ty - ey, tz - ez));
    let right = normalize(cross(fwd, vec3(0.0, 1.0, 0.0)) + vec3(0.0001, 0.0, 0.0));
    let top   = cross(right, fwd);
    let roll  = bank * 0.22 * sin(a + 0.4);

    eye    = vec3(ex, ey, ez);
    target = vec3(tx, ty, tz);
    up     = top * cos(roll) + right * sin(roll);
    fov_y  = clamp(base_fov - punch * 0.08 * kick, 0.55, 1.85);
    near   = 0.20;
    far    = 60.0;
  }
}
