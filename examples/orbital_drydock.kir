// Segmented orbital gantries frame a blue planet above the viewer.
// Dome-master coordinates; use Dome projection at zoom 1.0.
proc orbital_drydock {
  kind L4
  blend additive

  param spin : float [0.0, 1.0] = 0.18
  param traffic : float [0.0, 2.0] = 0.8
  param planet : float [0.07, 0.22] = 0.14
  param glow : float [0.0, 2.0] = 1.0
  param pulse : float [0.0, 1.0] = 0.0

  fragment {
    let p = point_coord * 2.0 - vec2(1.0);
    let r = length(p);
    let az = atan2(p.x, p.y + 0.000001);
    let cyan = srgb_to_linear(vec3(0.1, 0.72, 1.0));
    let white = srgb_to_linear(vec3(0.8, 0.9, 1.0));
    let amber = srgb_to_linear(vec3(1.0, 0.58, 0.13));
    // Fixed gantry rings and evenly spaced radial beams.
    let sector = fract(az * 12.0 / 6.2831853 + 0.5);
    let beam = 1.0 - smoothstep(0.008, 0.025, abs(sector - 0.5));
    let span = smoothstep(0.32, 0.34, r) * (1.0 - smoothstep(0.66, 0.68, r));
    let inner = exp(-abs(r - 0.34) * 550.0);
    let outer = exp(-abs(r - 0.66) * 550.0);
    let rail = exp(-abs(r - 0.58) * 450.0);
    let strut = step(0.40, abs(sector - 0.5)) * span;
    var rgb = white * (inner * 0.6 + outer * 0.7 + beam * span * 0.35)
            + cyan * (rail * 0.65 + strut * 0.07);
    let bay = (1.0 - smoothstep(0.23, 0.27, abs(sector - 0.5)))
             * smoothstep(0.59, 0.60, r) * (1.0 - smoothstep(0.64, 0.65, r));
    let ribs = exp(-abs(fract(r * 160.0) - 0.5) * 22.0);
    rgb += cyan * bay * (0.07 + ribs * 0.32);
    // Repeating docking signals and warm perimeter hazard marks.
    let marks = step(0.72, fract(az * 96.0 / 6.2831853));
    rgb += amber * marks * exp(-abs(r - 0.69) * 380.0) * 0.8;
    let signal = pow(0.5 + 0.5 * cos(az * 12.0 - t * traffic), 12.0);
    rgb += amber * bay * signal * (0.3 + pulse * 0.8);
    // Three cargo shuttles follow the circular service lane.
    for i in 0..3 {
      let angle = float(i) * 2.0943951 + t * spin * 0.18;
      let axis = vec2(sin(angle), cos(angle));
      let side = vec2(axis.y, -axis.x);
      let d = p - axis * 0.49;
      let q = vec2(dot(d, side), dot(d, axis));
      let hull = 1.0 - smoothstep(0.0, 0.002, max(abs(q.x) - 0.014, abs(q.y) - 0.006));
      let engine = exp(-length(q - vec2(-0.019, 0.0)) * 180.0);
      rgb += white * hull * 0.6 + cyan * engine * 0.7;
    }
    // Offset planet: closed-form sphere surface_normal, lit from the upper left.
    let q = (p - vec2(0.08, -0.035)) / planet;
    let pr = length(q);
    let surface = 1.0 - smoothstep(0.98, 1.02, pr);
    let surface_normal = vec3(q, sqrt(max(1.0 - dot(q, q), 0.0)));
    let daylight = max(dot(surface_normal, normalize(vec3(-0.6, -0.3, 0.7))), 0.0);
    let clouds = perlin(surface_normal * 5.0 + vec3(t * spin * 0.04, 0.0, 0.0));
    rgb += mix(cyan * 0.25, white * 0.7, vec3(smoothstep(0.0, 0.35, clouds)))
           * (0.04 + daylight * 0.7) * surface;
    rgb += cyan * exp(-abs(pr - 1.0) * 45.0) * 0.6;
    color = vec4(rgb * glow * (1.0 - smoothstep(0.88, 1.0, r)), 1.0);
  }
}
