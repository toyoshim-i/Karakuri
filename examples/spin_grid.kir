// A grid of ellipses in the xy plane, each traced by a chord turning about its
// cell's centre, all in step, leaving a fading trail of earlier chords.
// Ported from tmalib ext/mv/frame/spiline.
//
//     cargo run -p karakuri-cli -- --set examples/spin_grid.kir,examples/flat_eye.kir,examples/tint_strokes.kir

proc spin_grid {
  kind     L1
  topology lines

  // 32 trail chords per cell; 2048 holds an 8 by 8 grid.
  capacity [32, 8192] = 2048

  // Columns and rows of the grid; the whole part is used.
  param cols   : float [1.0, 16.0] = 8.0
  param rows   : float [1.0, 16.0] = 8.0

  // Half-width and half-height of the grid in world units.
  param half   : vec2 [0.1, 4.0]   = vec2(1.96, 1.1)

  // Radians per second the chord turns, and radians of turn between two
  // successive trail chords.
  param speed  : float [-12.0, 12.0] = 2.5
  param gap    : float [0.01, 1.0]   = 0.12

  // Decay of the trail per chord.
  param fade   : float [0.0, 1.0]    = 0.07

  // Colour of the newest chord.
  param color  : vec3 [0.0, 4.0]     = vec3(0.12, 0.12, 1.0)

  emit position, velocity, tint

  element {
    let nc   = max(floor(cols), 1.0);
    let nr   = max(floor(rows), 1.0);
    let k    = float(seed % 32u);
    let cell = float(seed / 32u);

    let cx = floor(cell % nc);
    let cy = floor(cell / nc);

    let rx = half.x * 2.0 / nc;
    let ry = half.y * 2.0 / nr;
    let ox = (cx + 0.5) * rx - half.x;
    let oy = half.y - (cy + 0.5) * ry;

    let dir = sign(speed + 0.0000001);
    let a0  = t * speed - k * gap * dir;
    let a1  = a0 - gap * dir;

    let p0 = vec3(ox + cos(a0) * rx, oy + sin(a0) * ry, 0.0);
    let p1 = vec3(ox + cos(a1) * rx, oy + sin(a1) * ry, 0.0);

    position = p0;
    velocity = p0 - p1;

    let used = cy < nr;
    if used {
      tint = color * exp(0.0 - fade * k);
    } else {
      tint = vec3(0.0);
    }
  }
}
