// A glowing vertical line in the middle of the frame that wiggles along its
// length like a plucked string, over a soft field of red rising left to right,
// a steadily pulsing blue and a green glow at the centre. `level` sets the
// swing, the line's brightness and the green glow; bind it to loudness.
// Draws the whole frame and reads no geometry.
//
//     cargo run -p karakuri-cli -- --set examples/step_grid.kir,examples/wiggle_bar.kir

proc wiggle_bar {
  kind  L4
  blend additive

  // Loudness, 0 to 1. At 0 the line is nearly still and thin.
  param level : float [0.0, 1.0] = 0.3

  // Radians per second of the wiggle.
  param speed : float [0.0, 20.0] = 7.0

  // Swing at full `level`, in frame half-heights.
  param gain  : float [0.0, 0.8] = 0.35

  // Width of the line's glow, in frame half-heights.
  param width : float [0.001, 0.05] = 0.008

  // Strength of the red ramp, the blue pulse and the green glow behind the line.
  param field : vec3 [0.0, 1.0] = vec3(0.35, 0.3, 0.35)

  // Radians per second of the blue pulse.
  param pulse : float [0.0, 8.0] = 1.5

  fragment {
    // Isotropic frame coordinates from the camera ray: y runs -1..1 bottom to
    // top, x spans the width at the same scale. Assumes the built-in 60 degree
    // field of view.
    let fw = normalize(-eye);
    let rt = normalize(cross(fw, vec3(0.0, 1.0, 0.0)));
    let up = cross(rt, fw);
    let p  = vec2(dot(ray, rt), dot(ray, up)) / (dot(ray, fw) * 0.57735027);

    // Two travelling waves under a string's envelope, pinned beyond the frame.
    let env = cos(p.y * 1.2);
    let sw  = gain * (0.03 + level) * env;
    let x   = sw * (0.7 * sin(p.y * 5.0 - t * speed) + 0.3 * sin(p.y * 11.0 + t * speed * 1.7));
    let d   = abs(p.x - x);
    let w   = width * (0.5 + level);
    let ln  = w / (d + w) * (0.35 + level);

    let red   = field.x * point_coord.x;
    let blue  = field.y * (0.5 + 0.5 * sin(t * pulse));
    let green = field.z * level * exp(-dot(p, p) * 1.5);
    let bg    = srgb_to_linear(vec3(red, green, blue));
    color = vec4(bg + vec3(0.9, 0.95, 1.0) * ln * ln * 2.0, 1.0);
  }
}
