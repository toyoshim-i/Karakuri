// Particles released near the centre that chase a chain of drifting waypoints
// one after another on a damped spring, then fall back to the centre and
// vanish. Each particle keeps the hue of the moment it was released.
// Ported from tmalib ext/mv/frame/nicofarre3d/waypoints.js.
//
//     cargo run -p karakuri-cli -- --set examples/waypoint_swarm.kir,examples/room_eye.kir,examples/room_glow.kir

proc waypoint_swarm {
  kind     L1
  topology lines
  capacity [1024, 262144] = 16384

  // Particles released per second.
  param spawn_rate : float [0.0, 4000.0] = 240.0

  // Number of waypoints a particle visits before it returns to the centre.
  param stops      : float [1.0, 64.0] = 32.0

  // Half-extent of the box the waypoints drift in, per axis.
  param roam       : vec3 [0.5, 40.0] = vec3(4.1, 2.0, 4.1)

  // Fastest waypoint drift, in world units per second.
  param wander     : float [0.0, 20.0] = 0.6

  // Spring strength towards the current waypoint, per second squared per unit
  // of distance.
  param pull       : float [0.1, 400.0] = 7.2

  // Fraction of its speed a particle keeps after one second.
  param damp       : float [0.001, 1.0] = 0.16

  // Distance at which a waypoint counts as reached.
  param reach      : float [0.05, 4.0] = 0.32

  // Seconds for the release hue to go once round the colour wheel.
  param cycle      : float [0.5, 60.0] = 6.0

  // `uv.x` holds the index of the waypoint being chased.
  emit position, velocity, uv, tint

  spawn {
    let r = hash3(seed);
    let c = hash2(seed + 3u);

    position = r;
    velocity = vec3(0.0);
    uv       = vec2(0.0, 0.0);
    tint     = hsv_to_rgb(vec3(fract(t / cycle), 1.0 - c.x * 0.25, c.y * 0.5));
  }

  element {
    let target = uv.x;
    let w      = uint(target);

    // Waypoint `w` bounces between the walls of the box on a straight path.
    let box  = roam * 2.0;
    let home = hash3(w * 2u + 7919u);
    let rate = (hash3(w * 2u + 7920u) * 2.0 - vec3(1.0)) * wander / box;
    let tri  = vec3(1.0) - abs(mod(home + rate * t, vec3(2.0)) - vec3(1.0));
    var goal = (tri - vec3(0.5)) * box;
    if target >= floor(stops) {
      goal = vec3(0.0);
    }

    let d    = goal - position;
    var next = target;
    var kick = vec3(0.0);
    if dot(d, d) < reach * reach {
      next = target + 1.0;
      kick = (hash3(seed * 131u + w) * 2.0 - vec3(1.0)) * 0.06;
    }

    let v = (velocity + kick + d * pull * dt) * pow(damp, dt);

    velocity = v;
    position = position + v * dt;
    uv       = vec2(next, 0.0);
    tint     = tint;

    if next > floor(stops) {
      kill();
    }
  }
}
