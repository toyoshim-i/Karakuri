// A Julia set filling the frame, its constant circling the edge of the
// Mandelbrot cardioid so the fractal keeps unfolding, turning slowly and
// breathing in and out of zoom, coloured by a smooth escape count through a
// cycling cosine palette. Draws the whole frame and reads no geometry; a camera
// looking at the origin sets the frame's aspect.
//
//     cargo run -p karakuri-cli -- --set examples/step_grid.kir,examples/julia_bloom.kir

proc julia_bloom {
  kind  L4
  blend additive

  // Half the visible height of the complex plane at the widest breath.
  param reach    : float [0.2, 3.0] = 1.25

  // Depth of the zoom breath: 0 holds still, 1 zooms in to a tenth.
  param breath   : float [0.0, 1.0] = 0.55

  // Speed of the constant's circuit, in turns per minute.
  param circuit  : float [0.0, 12.0] = 1.5

  // Rotation of the plane in radians per second.
  param spin     : float [-1.0, 1.0] = 0.05

  // Palette cycles per unit of the square root of the escape count; higher
  // packs more colour bands against the set's edge.
  param bands    : float [0.05, 1.0] = 0.22

  // Palette drift in cycles per second.
  param flow     : float [-1.0, 1.0] = 0.08

  // Brightness multiplier.
  param exposure : float [0.0, 4.0] = 1.0

  fragment {
    let fw  = normalize(-eye);
    let rt  = normalize(cross(fw, vec3(0.0, 1.0, 0.0)));
    let upv = cross(rt, fw);
    let sc  = vec2(dot(ray, rt), dot(ray, upv)) / (dot(ray, fw) * 0.57735);

    let zm = reach * mix(1.0, 0.1, breath * (0.5 - 0.5 * cos(t * 0.21)));
    let ca = cos(t * spin);
    let sa = sin(t * spin);
    var z  = vec2(sc.x * ca - sc.y * sa, sc.x * sa + sc.y * ca) * zm;

    // A point just outside the main cardioid's boundary.
    let th = t * circuit * 0.10471976;
    let cb = vec2(0.5 * cos(th) - 0.25 * cos(2.0 * th), 0.5 * sin(th) - 0.25 * sin(2.0 * th));
    let c  = cb * 1.02;

    var n = 0.0;
    var m = dot(z, z);
    for i in 0..96 {
      if m < 256.0 {
        z = vec2(z.x * z.x - z.y * z.y, 2.0 * z.x * z.y) + c;
        m = dot(z, z);
        n += 1.0;
      }
    }

    let inside = step(256.0, m);
    let s = n - log2(max(log2(max(m, 1.0001)), 0.0001)) + 4.0;
    let k = sqrt(max(s, 0.0)) * bands + t * flow;
    let pal = vec3(0.5) + vec3(0.5) * vec3(cos(6.2831853 * k), cos(6.2831853 * (k + 0.33)), cos(6.2831853 * (k + 0.67)));
    let fade = pow(clamp(s / 60.0, 0.0, 1.0), 1.5);

    color = vec4(srgb_to_linear(pal) * fade * inside * exposure, 1.0);
  }
}
