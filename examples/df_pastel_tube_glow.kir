// df_pastel_tube_glow (`L4`) — Pastel fluorescent glass tube & translucent acrylic aura renderer.

proc df_pastel_tube_glow {
  kind  L4
  blend additive

  param width     : float [0.004, 0.065] = 0.030
  param exposure  : float [0.10, 6.0]    = 0.95
  param core_milk : float [0.0, 4.0]     = 0.42
  param falloff   : float [1.0, 8.0]     = 2.70

  consumes position, velocity, tint, size

  vertex {
    clip       = camera * vec4(position, 1.0);
    clip_b     = camera * vec4(position - velocity, 1.0);
    point_rate = width * size;
  }

  fragment {
    let across = abs(point_coord.y * 2.0 - 1.0);
    let along  = point_coord.x;

    // Wide pastel scatter aura + rich pastel phosphor body + crisp milky glass core
    let aura  = pow(max(0.0, 1.0 - across), falloff);
    let halo  = exp(-across * across * 12.0);
    let glass = exp(-across * across * 56.0);
    let core  = glass * glass;

    let end_d = min(along, 1.0 - along) * 2.0;
    let cap   = smoothstep(0.0, 0.12, end_d);

    let luma  = dot(tint, vec3(0.299, 0.587, 0.114));
    let milky = vec3(1.0, 0.99, 1.0) * (core * core_milk * clamp(luma * 0.55, 0.0, 2.0));
    let col   = (tint * (aura * 0.32 + halo * 0.82 + glass * 1.25) + milky) * exposure;
    let emis  = (aura * 0.45 + halo * 0.68 + glass * 0.90) * (0.82 + 0.18 * cap);

    color = vec4(col, emis);
  }
}
