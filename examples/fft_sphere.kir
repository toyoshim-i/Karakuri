// Pushes the vertices of a line-drawn sphere outward by the audio spectrum:
// the eight band levels are laid twice around the sphere along a spiral from
// pole to pole, so each band lifts its own stripe of the surface, and every
// vertex takes its own random share of the lift, so a loud band grows spikes
// rather than a smooth bulge. Both ends of every segment are moved by the same
// function of where they are, so shared vertices stay joined. Applies only to
// the geometry bound to `only`.
// Ported from the sphere scene of majvj-vrdj-2021 scenes/sphere.js.
//
//     cargo run -p karakuri-cli -- --take-in examples/fft_sphere.kset
//     cargo run -p karakuri-cli -- --load-set fft_sphere

proc fft_sphere {
  kind L2

  // The geometry to deform; every other source passes through untouched.
  uses only : Source

  // Band levels, lowest band first. Bind to band0 .. band7.
  param level0 : float [0.0, 1.0] = 0.5
  param level1 : float [0.0, 1.0] = 0.6
  param level2 : float [0.0, 1.0] = 0.45
  param level3 : float [0.0, 1.0] = 0.35
  param level4 : float [0.0, 1.0] = 0.3
  param level5 : float [0.0, 1.0] = 0.2
  param level6 : float [0.0, 1.0] = 0.15
  param level7 : float [0.0, 1.0] = 0.1

  // Outward push at a band level of 1, as a fraction of the vertex's distance
  // from the centre.
  param gain   : float [0.0, 3.0]  = 1.0

  // How much of the push each vertex takes at random: 0 is a smooth swell,
  // 1 lets some vertices take none of it.
  param grit   : float [0.0, 1.0]  = 0.5

  consumes position, velocity

  mask {
    strength = 0.0;
    if source == only {
      strength = 1.0;
    }
  }

  deform {
    let lo = vec4(level0, level1, level2, level3);
    let hi = vec4(level4, level5, level6, level7);
    let i_lo = vec4(0.0, 1.0, 2.0, 3.0);
    let i_hi = vec4(4.0, 5.0, 6.0, 7.0);

    // Near end.
    let p0  = position;
    let n0  = normalize(p0 + vec3(0.0, 0.0, 0.000001));
    let lon0 = atan2(n0.y, n0.x) / 6.2831853 + 0.5;
    let b0  = fract(lon0 * 2.0 + acos(clamp(n0.z, -1.0, 1.0)) / 3.1415927) * 8.0;
    let w0l = max(vec4(1.0) - abs(mod(vec4(b0) - i_lo + vec4(4.0), vec4(8.0)) - vec4(4.0)), vec4(0.0));
    let w0h = max(vec4(1.0) - abs(mod(vec4(b0) - i_hi + vec4(4.0), vec4(8.0)) - vec4(4.0)), vec4(0.0));
    let k0  = uint(round((n0.x + 2.0) * 500.0)) * 7919u + uint(round((n0.y + 2.0) * 500.0)) * 131u
            + uint(round((n0.z + 2.0) * 500.0));
    let q0  = p0 * (1.0 + gain * (dot(lo, w0l) + dot(hi, w0h)) * (1.0 - grit * hash1(k0)));

    // Far end, by the same function.
    let p1  = position - velocity;
    let n1  = normalize(p1 + vec3(0.0, 0.0, 0.000001));
    let lon1 = atan2(n1.y, n1.x) / 6.2831853 + 0.5;
    let b1  = fract(lon1 * 2.0 + acos(clamp(n1.z, -1.0, 1.0)) / 3.1415927) * 8.0;
    let w1l = max(vec4(1.0) - abs(mod(vec4(b1) - i_lo + vec4(4.0), vec4(8.0)) - vec4(4.0)), vec4(0.0));
    let w1h = max(vec4(1.0) - abs(mod(vec4(b1) - i_hi + vec4(4.0), vec4(8.0)) - vec4(4.0)), vec4(0.0));
    let k1  = uint(round((n1.x + 2.0) * 500.0)) * 7919u + uint(round((n1.y + 2.0) * 500.0)) * 131u
            + uint(round((n1.z + 2.0) * 500.0));
    let q1  = p1 * (1.0 + gain * (dot(lo, w1l) + dot(hi, w1h)) * (1.0 - grit * hash1(k1)));

    position = q0;
    velocity = q0 - q1;
  }
}
