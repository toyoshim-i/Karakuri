// A 360-degree cyan and magenta skyline beneath falling digital rain.
// Dome-master coordinates: centre = zenith, radius .75 = horizon.
proc neon_megacity {
  kind L4
  blend additive

  param towers : float [16.0, 64.0] = 44.0
  param rain : float [0.0, 2.0] = 0.8
  param speed : float [0.0, 2.0] = 0.65
  param glow : float [0.0, 2.0] = 1.0
  param pulse : float [0.0, 1.0] = 0.0

  fragment {
    let p = point_coord * 2.0 - vec2(1.0);
    let r = length(p);
    let az = atan2(p.x, p.y + 0.000001);
    let u = fract(az / 6.2831853 + 0.5);
    let count = floor(towers);
    let cell = floor(u * count);
    let h = hash3(uint(cell) * 7919u + 53u);
    let x = abs(fract(u * count) - 0.5);
    let top = 0.43 + h.x * 0.23;
    let width = 0.25 + h.y * 0.18;
    let inside = (1.0 - smoothstep(width - 0.02, width, x))
               * smoothstep(top - 0.003, top, r) * (1.0 - smoothstep(0.78, 0.81, r));
    let side = 1.0 - smoothstep(0.0, 0.018, abs(x - width));
    let roof = 1.0 - smoothstep(0.0, 0.003, abs(r - top));
    let outline = (side * step(top, r) + roof * step(x, width))
                * (1.0 - smoothstep(0.78, 0.81, r));
    let wx = floor(fract(u * count) * 6.0);
    let wy = floor((r - top) * 110.0);
    let windows = step(0.38, hash1(uint(cell) * 104729u + uint(max(wy, 0.0)) * 31u + uint(wx)))
                * (1.0 - smoothstep(0.22, 0.35, abs(fract(u * count * 6.0) - 0.5)))
                * (1.0 - smoothstep(0.20, 0.36, abs(fract((r - top) * 110.0) - 0.5)));
    let cyan = srgb_to_linear(vec3(0.08, 0.9, 1.0));
    let pink = srgb_to_linear(vec3(1.0, 0.13, 0.55));
    let hue_color = mix(cyan, pink, vec3(step(0.55, h.z)));
    var rgb = hue_color * (outline * 0.85 + inside * (0.025 + windows * 0.28));
    // Narrow holographic advertising panels on alternating towers.
    let panel = step(0.65, h.y) * step(x, width * 0.5)
               * step(top + 0.025, r) * step(r, top + 0.075);
    let text = step(0.45, fract(r * 190.0 + floor(u * count * 12.0) * 0.37));
    rgb += pink * panel * (0.12 + text * 0.7) * (1.0 + pulse);

    // Rain uses an integer number of azimuth columns to close the back seam.
    let column = floor(u * 180.0);
    let rh = hash3(uint(column) * 3571u + 11u);
    let head = fract(r * 2.3 - t * speed * (0.12 + rh.x * 0.15) + rh.y);
    let streak = exp(-head * 32.0) * (1.0 - smoothstep(0.03, 0.12, abs(fract(u * 180.0) - 0.5)));
    let rain_mask = smoothstep(0.15, 0.35, r) * (1.0 - smoothstep(0.73, 0.85, r));
    rgb += cyan * streak * rain_mask * rain * (1.0 - inside * 0.9);
    rgb += pink * exp(-abs(r - 0.76) * 25.0) * 0.12;
    let rim = 1.0 - smoothstep(0.88, 1.0, r);
    color = vec4(rgb * glow * rim, 1.0);
  }
}
