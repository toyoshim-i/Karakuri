// A camera standing at the centre of a room and turning slowly on the spot, so
// the four walls pass in front of it in turn.
// Ported from tmalib ext/mv/frame/nicofarre3d/main.js.
//
//     cargo run -p karakuri-cli -- --set examples/room_beams.kir,examples/room_eye.kir,examples/room_glow.kir

proc room_eye {
  kind L3

  // Yaw speed in radians per second. 0 holds the view on one wall.
  param turn    : float [-1.0, 1.0] = 0.08

  // Yaw at t = 0 in radians. 0 faces the stage, down negative z.
  param heading : float [-3.1416, 3.1416] = 0.0

  // Height of the eye above the room's centre.
  param rise    : float [-4.0, 4.0] = 0.0

  // Vertical offset of the look direction; negative looks at the floor.
  param tilt    : float [-1.0, 1.0] = 0.0

  // Vertical field of view in radians.
  param lens    : float [0.6, 2.2] = 1.3

  camera {
    let yaw = heading + t * turn;
    let e   = vec3(0.0, rise, 0.0);

    eye    = e;
    target = e + vec3(-sin(yaw), tilt, -cos(yaw));
    fov_y  = lens;
  }
}
