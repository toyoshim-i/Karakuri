// Swirling marbled ink: fractal noise whose sampling position is itself pushed
// around by two further layers of fractal noise, so the pattern folds into
// eddies that slowly stir: deep ink in the troughs, a second colour on the
// crests and thin bright veins along the level between them. Draws the whole frame
// and reads no geometry; a camera looking at the origin sets the frame's aspect.
//
//     cargo run -p karakuri-cli -- --set examples/step_grid.kir,examples/ink_marble.kir

proc ink_marble {
  kind  L4
  blend additive

  // Size of the largest eddies: higher is finer.
  param grain    : float [0.2, 4.0] = 0.55

  // How far the flow pushes the pattern; 0 is plain noise.
  param warp     : float [0.0, 8.0] = 3.5

  // Stirring speed.
  param stir     : float [0.0, 1.0] = 0.06

  // Hue of the currents; the folds sit a little bluer and the veins take the
  // complementary hue.
  param hue      : float [0.0, 1.0] = 0.52

  // Brightness multiplier.
  param exposure : float [0.0, 4.0] = 1.0

  fragment {
    let fw  = normalize(-eye);
    let rt  = normalize(cross(fw, vec3(0.0, 1.0, 0.0)));
    let upv = cross(rt, fw);
    let sc  = vec2(dot(ray, rt), dot(ray, upv)) / (dot(ray, fw) * 0.57735);

    let s = t * stir;
    let p = vec3(sc * grain, s);

    let q = vec2(fbm(p, 4), fbm(p + vec3(5.2, 1.3, 0.7 * s), 4));
    let r = vec2(fbm(p + vec3(q * warp, 0.0) + vec3(1.7, 9.2, 0.0), 4),
                 fbm(p + vec3(q * warp, 0.0) + vec3(8.3, 2.8, s), 4));
    let f = fbm(p + vec3(r * warp, 0.0), 5);

    let a  = smoothstep(-0.45, 0.45, f);
    let b  = smoothstep(0.1, 0.7, length(q));
    let vn = exp(-abs(f) * 22.0) * b;

    let ink     = hsv_to_rgb(vec3(fract(hue + 0.1), 0.95, 0.3));
    let current = hsv_to_rgb(vec3(hue, 0.85, 0.72));
    let vein    = hsv_to_rgb(vec3(fract(hue + 0.55), 0.65, 1.0));

    let c = mix(ink, current, vec3(a * a));
    let shade = 0.2 + 0.8 * a;
    let lin = c * shade + vein * vn * 1.5;

    color = vec4(lin * exposure, 1.0);
  }
}
