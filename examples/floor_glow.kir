// A light source off the bottom of the frame, its glow falling off as one over
// the distance and stretched upward into a column.
// Ported from tmalib ext/mv/frame/light.
//
//     cargo run -p karakuri-cli -- --set examples/orbit_motes.kir,examples/floor_glow.kir,examples/halo_points.kir

proc floor_glow {
  kind  L4
  blend additive

  // Colour of the glow at one unit of stretched distance from the source, in
  // sRGB; the falloff is applied before the conversion to linear.
  param glow    : vec3 [0.0, 1.0]  = vec3(0.0, 0.0, 0.03)

  // Where the source is, in frame coordinates from -1 to 1 with y up.
  param spot    : vec2 [-4.0, 4.0] = vec2(0.0, -1.2)

  // How far the glow reaches on each axis; a larger value stretches it.
  param stretch : vec2 [0.1, 10.0] = vec2(1.0, 5.0)

  fragment {
    let v = vec2(point_coord.x * 2.0 - 1.0, 1.0 - point_coord.y * 2.0);
    let d = distance(v / stretch, spot / stretch);

    color = vec4(srgb_to_linear(glow / max(d, 0.001)), 1.0);
  }
}
