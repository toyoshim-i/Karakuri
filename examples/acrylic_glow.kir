// Recolours the picture as a lit acrylic plate: brightness drives a tinted
// glaze, and three lights below the bottom edge wash the frame with the tint.
// Ported from tmalib ext/mv/effect/acrylic.

proc acrylic_glow {
  kind L5

  // Colour of the glaze and of the lights, linear RGB.
  param glaze : vec3 [0.0, 1.0] = vec3(0.0, 0.0, 1.0)
  // Brightness of the three lights below the bottom edge.
  param lights : float [0.0, 4.0] = 1.0
  // Blend from the untouched picture (0) to the full effect (1).
  param amount : float [0.0, 1.0] = 1.0

  frame {
    let s    = texel(src);
    let luma = dot(s.xyz, vec3(0.299, 0.587, 0.114)) * 4.0;
    let base = (vec3(0.1) + s.xyz * 0.2 + glaze * 0.6) * (luma * luma);

    // Frame position in [-1, 1] with y up, y compressed by 3 for the light falloff.
    let p  = vec2(point_coord.x * 2.0 - 1.0, (1.0 - point_coord.y * 2.0) / 3.0);
    let d1 = distance(p, vec2(-1.0, -0.5));
    let d2 = distance(p, vec2(0.0, -0.5));
    let d3 = distance(p, vec2(1.0, -0.5));
    let glow = glaze * (0.1 * lights * (1.0 / d1 + 1.0 / d2 + 1.0 / d3));

    color = vec4(mix(s.xyz, base + glow, vec3(amount)), mix(s.w, 1.0, amount));
  }
}
