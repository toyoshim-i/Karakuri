// A few long lines whose two ends bounce independently around the inside of a
// cube while their colours drift, each leaving a fading ribbon of its past
// positions.
// Ported from tmalib example/nicofarre/mv_nico08.html.
//
//     cargo run -p karakuri-cli -- --set examples/line_bounce.kir,examples/line_split.kir,examples/room_eye.kir,examples/room_strokes.kir

proc line_bounce {
  kind     L1
  topology lines
  capacity [32, 65536] = 2048

  // Number of lines. Capacity divided by this is how many past positions each
  // line keeps.
  param count  : float [1.0, 512.0] = 32.0

  // Half the side of the cube the ends bounce in.
  param room   : float [1.0, 40.0] = 10.0

  // Fastest end speed in world units per second.
  param pace   : float [0.0, 30.0] = 6.0

  // Seconds between two kept past positions.
  param lag    : float [0.002, 0.2] = 0.0167

  // Brightness kept from one past position to the next.
  param trail  : float [0.0, 0.999] = 0.91

  // Fastest colour drift, in full colour ranges per second.
  param hueing : float [0.0, 2.0] = 0.6

  // Brightness multiplier on each line's colour.
  param bright : float [0.0, 4.0] = 0.2

  emit position, velocity, tint

  element {
    let per  = uint(max(count, 1.0));
    let back = seed / per;
    let line = seed % per;
    let at   = t - float(back) * lag;
    let span = room * 2.0;

    let p0 = hash3(line * 7u);
    let p1 = hash3(line * 7u + 1u);
    let v0 = (hash3(line * 7u + 2u) - vec3(0.5)) * pace * 2.0 / span;
    let v1 = (hash3(line * 7u + 3u) - vec3(0.5)) * pace * 2.0 / span;
    let c0 = hash3(line * 7u + 4u);
    let cv = hash3(line * 7u + 5u) * hash3(line * 7u + 6u) * hueing;

    // A triangle wave in [0, 1] is a straight path reflected off both walls.
    let a = vec3(1.0) - abs(mod(p0 + v0 * at, vec3(2.0)) - vec3(1.0));
    let b = vec3(1.0) - abs(mod(p1 + v1 * at, vec3(2.0)) - vec3(1.0));
    let c = vec3(1.0) - abs(mod(c0 + cv * at, vec3(2.0)) - vec3(1.0));

    position = (a - vec3(0.5)) * span;
    velocity = (a - b) * span;
    tint     = srgb_to_linear(c) * pow(trail, float(back)) * bright;
  }
}
