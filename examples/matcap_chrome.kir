// Polished chrome material preset using screen-space flat normals and opaque depth writes.
// Evaluates specular reflections and sharp reflection bands across the normal hemisphere.

proc matcap_chrome {
  kind  L4
  blend opaque

  consumes position

  param light_dir : vec3 [-1.0, 1.0] = vec3(0.4, 0.8, 0.5)
  param exposure  : float [0.0, 4.0]  = 1.0

  vertex {
    clip       = camera * vec4(position, 1.0);
    point_rate = 1.0;
  }

  fragment {
    let n = flat_normal(position);
    // View approximation towards forward axis
    let v = vec3(0.0, 0.0, 1.0);
    let r = reflect(-v, n);

    // High-contrast reflection bands based on reflection ray y
    let band = sin(r.y * 10.0 + r.x * 4.0) * 0.5 + 0.5;
    let horizon = smoothstep(-0.08, 0.08, r.y);
    let sky = mix(vec3(0.12, 0.14, 0.22), vec3(0.92, 0.96, 1.0), vec3(horizon));
    let ground = mix(vec3(0.18, 0.12, 0.08), vec3(0.55, 0.50, 0.45), vec3(r.y * 0.5 + 0.5));

    let base = mix(ground, sky, vec3(horizon)) + vec3(pow(band, 6.0) * 0.35);
    let l = normalize(light_dir);
    let spec = pow(max(dot(r, l), 0.0), 24.0);

    let chrome = base + vec3(spec);
    color = vec4(chrome * exposure, 1.0);
  }
}
