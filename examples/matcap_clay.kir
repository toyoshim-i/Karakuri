// Soft sculpted clay matcap shading using screen-space flat normals and opaque depth writes.
// Provides warm key lighting, cool fill light, ambient wrap, and subtle rim illumination.

proc matcap_clay {
  kind  L4
  blend opaque

  consumes position

  param light_dir : vec3 [-1.0, 1.0] = vec3(0.5, 0.8, 0.6)
  param warm_hue  : float [0.0, 1.0]  = 0.08
  param cool_hue  : float [0.0, 1.0]  = 0.60
  param exposure  : float [0.0, 4.0]  = 1.1

  vertex {
    clip       = camera * vec4(position, 1.0);
    point_rate = 1.0;
  }

  fragment {
    let n = flat_normal(position);
    let l = normalize(light_dir);
    let ndotl = dot(n, l);

    // Warm key light
    let key = max(ndotl, 0.0);
    // Cool fill light from opposite
    let fill = max(-ndotl * 0.5 + 0.5, 0.0) * 0.45;
    // Ambient term
    let amb = 0.18;

    let warm_col = hsv_to_rgb(vec3(warm_hue, 0.45, 0.95));
    let cool_col = hsv_to_rgb(vec3(cool_hue, 0.35, 0.75));

    let lit = warm_col * key + cool_col * fill + warm_col * amb;
    color = vec4(lit * exposure, 1.0);
  }
}
