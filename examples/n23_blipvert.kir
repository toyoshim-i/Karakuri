// A blipvert: a whole commercial compressed into a burst. Every cut lands on a new hard
// two-colour pattern (squares, stripes, checks, wedges, zigzag, spiral), a boxed diamond
// icon jumps to a new place, and a banner of copy glyphs runs along the bottom, then the
// next cut arrives. Cuts come at `rate` per second and time also stutters on one moment
// now and then. Photosensitivity: keep `rate` at or below three cuts per second when
// this is shown to an audience; the colours are saturated, never white, and no cut
// alternates between light and dark on its own. Draws the whole frame and reads no
// geometry.

proc n23_blipvert {
  kind  L4
  blend additive

  // Cuts per second. Three or fewer is safe for a general audience.
  param rate    : float [0.5, 12.0] = 3.0

  // How often time stutters: 0 never, 1 nearly always.
  param stutter : float [0.0, 1.0] = 0.4

  // Length of the repeated window while stuttering, in seconds.
  param window  : float [0.04, 0.4] = 0.12
  // Start of this piece's eight-second window inside a 32-second loop, in seconds;
  // negative runs it all the time.
  param start   : float [-1.0, 24.0] = -1.0
  // Hit strength: forces a stutter and pushes activity up. Bind to an onset.
  param kick    : float [0.0, 1.0] = 0.0

  fragment {
    // Isotropic frame coordinates: y runs -1..1 bottom to top. Assumes the
    // built-in 60 degree field of view.
    let fw = normalize(-eye);
    let rt = normalize(cross(fw, vec3(0.0, 1.0, 0.0)));
    let up = cross(rt, fw);
    let p  = vec2(dot(ray, rt), dot(ray, up)) / (dot(ray, fw) * 0.57735027);
    // Eight-second window inside a 32-second loop; a negative start disables it.
    let lt0  = mod(t, 32.0) - start;
    let lt   = mix(t, lt0, step(0.0, start));
    let win  = mix(1.0, step(0.0, lt0) * step(lt0, 8.0), step(0.0, start));
    let fade = mix(1.0, clamp(min(lt0, 8.0 - lt0) / 0.15, 0.0, 1.0), step(0.0, start)) * win;
    // Stutter clock: every 1.7 seconds a gate decides whether the next 0.6 seconds
    // loop over one short window, so the picture repeats itself on one moment.
    let seg  = floor(t / 1.7);
    let ph   = t - seg * 1.7;
    let gate = max(step(1.0 - stutter * 0.6, hash1(uint(seg) * 977u + 3u)), step(0.5, kick));
    let on   = gate * step(ph, 0.6);
    let anchor = seg * 1.7 + 0.15 + hash1(uint(seg) * 31u + 5u) * 0.3;
    let tt   = mix(t, anchor + mod(ph, window), on);

    let fi  = floor(tt * rate);
    let hh  = hash3(uint(fi + 50.0) * 7919u + 13u);
    let pid = floor(hh.x * 6.0);
    let ft  = fi * 0.37;

    // Two colours per cut, half a wheel apart with a small offset.
    let h0  = floor(hh.y * 8.0) / 8.0;
    let ca  = srgb_to_linear(hsv_to_rgb(vec3(h0, 1.0, 0.95)));
    let cb  = srgb_to_linear(hsv_to_rgb(vec3(fract(h0 + 0.5 + floor(hh.z * 3.0) / 8.0), 1.0, 0.8)));

    let m0 = step(0.5, fract(max(abs(p.x) * 0.6, abs(p.y)) * 4.0 - ft));
    let m1 = step(0.5, fract((p.x + p.y) * 3.0 + ft));
    let m2 = step(0.5, fract(floor(p.x * 4.0 + ft * 3.0) * 0.5 + floor(p.y * 4.0) * 0.5));
    let m3 = step(0.5, fract(atan2(p.y, p.x) * 1.2732395 + ft * 0.5));
    let m4 = step(abs(fract(p.x * 2.0 + ft) - 0.5), fract(p.y * 1.2 + ft) * 0.5);
    let m5 = step(0.5, fract(atan2(p.y, p.x) * 0.477465 + length(p) * 2.5 - ft));
    let sel = m0 * (1.0 - step(0.5, abs(pid)))
            + m1 * (1.0 - step(0.5, abs(pid - 1.0)))
            + m2 * (1.0 - step(0.5, abs(pid - 2.0)))
            + m3 * (1.0 - step(0.5, abs(pid - 3.0)))
            + m4 * (1.0 - step(0.5, abs(pid - 4.0)))
            + m5 * (1.0 - step(0.5, abs(pid - 5.0)));
    var c = mix(ca, cb, vec3(sel));

    // The product: a black-outlined white diamond with a ring, somewhere new each cut.
    let hp  = (hash2(uint(fi + 50.0) * 6151u + 7u) - vec2(0.5)) * vec2(1.4, 0.5);
    let dq  = p - hp;
    let dd  = abs(dq.x) + abs(dq.y);
    let ring = step(abs(length(dq) - 0.11), 0.012);
    c = mix(c, vec3(0.0), vec3(step(dd, 0.36)));
    c = mix(c, vec3(0.9), vec3(step(dd, 0.3)));
    c = mix(c, ca * 0.5, vec3(ring * step(dd, 0.3)));

    // Copy banner: two rows of glyph cells on a white strip at the bottom.
    let cw   = 0.045;
    let bnr  = step(abs(p.y + 0.7), 0.13) * step(abs(p.x), 1.5);
    let rw   = floor((p.y + 0.83) / 0.11);
    let cxl  = floor((p.x + 1.5) / cw);
    let gx   = floor(fract((p.x + 1.5) / cw) * 5.0);
    let gy   = floor(fract((p.y + 0.83) / 0.11) * 7.0);
    let ins  = step(0.5, gx) * step(gx, 3.5) * step(0.5, gy) * step(gy, 5.5);
    let bit  = step(0.4, hash1(uint(cxl + 50.0) * 7919u + uint(rw + 5.0) * 104729u + uint(gx * 8.0 + gy) * 31u + uint(fi + 50.0) * 977u));
    c = mix(c, vec3(0.9), vec3(bnr));
    c = mix(c, vec3(0.0), vec3(bnr * ins * bit));

    color = vec4(c * 0.9 * fade, 1.0);

  }
}
