// Projects the incoming visual onto a celestial dome or fisheye hemisphere for
// VR viewing. Blends from a planar frame to a dome ceiling (`dome`), with
// optional polar panorama unrolling (`wrap`), beat-synced rotation (`spin`),
// and kaleidoscopic facet folding (`facets`, `mirror`).
//
// Designed to wrap 2D screen-space visuals (and 3D master mixes) into immersive
// sky domes and kaleidoscopic mandalas in VR headsets.

proc vr_dome_wrap {
  kind L5

  // Curvature: 0.0 is the flat rectangular frame, 1.0 is a full spherical dome.
  param dome     : float [0.0, 1.0] = 1.0

  // Angular field of view of the dome in degrees. 180 is a full hemisphere.
  param fov      : float [60.0, 240.0] = 180.0

  // Blend from planar dome projection (0.0) to polar panorama unwrap (1.0).
  param wrap     : float [0.0, 1.0] = 0.0

  // Kaleidoscope facets: 0.0 is smooth dome; 3.0 to 16.0 splits into symmetry wedges.
  param facets   : float [0.0, 16.0] = 0.0

  // Reflection symmetry: 1.0 mirrors alternate wedges; 0.0 repeats cyclically.
  param mirror   : float [0.0, 1.0] = 1.0

  // Rotation speed in turns per beat.
  param spin     : float [-2.0, 2.0] = 0.0

  // Frame magnification around the dome zenith.
  param zoom     : float [0.2, 4.0] = 1.0

  // Seamless mirrored tiling (1.0) versus clamped single frame (0.0).
  param tile     : float [0.0, 1.0] = 1.0

  // Horizon edge darkening / vignette falloff towards the rim.
  param vignette : float [0.0, 1.0] = 0.3

  frame {
    let fs     = frame_step(1.0);
    let aspect = fs.y / fs.x;

    // Centered coordinates with aspect ratio preserved, zenith at (0, 0).
    let p = vec2((point_coord.x * 2.0 - 1.0) * aspect, 1.0 - point_coord.y * 2.0) / zoom;
    let r = length(p);

    // Continuous rotation angle with beat tracking.
    let rot = spin * beats * 6.2831853;
    let a   = (atan2(p.y, p.x) - rot) % 6.2831853;
    let a_norm = (a + 6.2831853) % 6.2831853;

    // Kaleidoscopic fold when facets >= 2.0.
    let n     = max(2.0, floor(facets + 0.5));
    let wedge = 6.2831853 / n;
    let idx   = floor(a_norm / wedge);
    var phi   = a_norm - idx * wedge;
    if mirror > 0.5 && idx % 2.0 >= 1.0 {
      phi = wedge - phi;
    }

    let p_kaleido = r * vec2(cos(phi), sin(phi));
    let k_blend   = clamp(facets - 1.0, 0.0, 1.0);
    let q         = mix(p, p_kaleido, vec2(k_blend));
    let rq        = length(q);

    // Dome distortion: spherical fisheye mapping.
    let fov_rad   = fov * (3.14159265 / 180.0);
    let theta     = rq * (fov_rad * 0.5);
    let r_sphere  = tan(clamp(theta * 0.5, 0.0, 1.45)) * 2.0;
    let r_curved  = mix(rq, r_sphere, dome);
    let q_dome    = q * (r_curved / max(rq, 0.0001));

    // Planar dome coordinates mapped back into [0, 1] frame coordinates.
    let coord_planar = vec2(q_dome.x / aspect * 0.5 + 0.5, 0.5 - q_dome.y * 0.5);

    // Polar panorama unwrap: angle around zenith -> u, radius -> v.
    let a_polar   = (atan2(q.y, q.x) / 6.2831853 + 0.5 + beats * spin) % 1.0;
    let coord_polar = vec2(fract(a_polar), clamp(rq / (aspect * 1.2), 0.0, 1.0));

    let coord_raw = mix(coord_planar, coord_polar, vec2(wrap));

    // Boundary handling: seamless mirror tiling vs clamped frame.
    let coord_tiled = abs(fract(coord_raw * 0.5 + 0.5) * 2.0 - 1.0);
    let at          = mix(clamp(coord_raw, vec2(0.0), vec2(1.0)), coord_tiled, vec2(tile));

    // Frame boundary mask (only active when tile is 0).
    let in_bounds = step(0.0, coord_raw.x) * step(coord_raw.x, 1.0) * step(0.0, coord_raw.y) * step(coord_raw.y, 1.0);
    let mask      = mix(in_bounds, 1.0, tile);

    // Horizon vignette: smooth falloff at the outer dome perimeter.
    let vig = smoothstep(1.0, max(0.2, 1.0 - vignette * 0.6), rq / aspect);

    let s = tap(src, at);
    color = s * (mask * vig);
  }
}
