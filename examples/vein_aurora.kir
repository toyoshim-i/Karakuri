// A wide horizontal band across the middle of the frame, fading to black above
// and below, filled with fine veins of turbulent noise. Each colour channel
// has its own grain, so the veins part into red, green and blue filaments with
// white where they cross. It crawls and mutates slowly.
// Draws the whole frame and reads no geometry.
//
//     cargo run -p karakuri-cli -- --set examples/step_grid.kir,examples/vein_aurora.kir

proc vein_aurora {
  kind  L4
  blend additive

  // Rate at which the noise evolves.
  param evolve   : float [0.0, 1.0] = 0.08

  // Noise cells across the frame's half-height, for the green channel.
  param scale    : float [0.5, 12.0] = 3.5

  // Ratio between neighbouring channels' grain: red is `scale / grain`, blue
  // is `scale * grain`.
  param grain    : float [1.0, 2.0] = 1.35

  // Half-height of the band, as a fraction of the frame's half-height.
  param band     : float [0.1, 1.0] = 0.7

  // How thin and bright the veins are.
  param contrast : float [2.0, 48.0] = 16.0

  // Gain of each channel.
  param gains    : vec3 [0.0, 4.0] = vec3(1.0, 0.8, 1.2)

  fragment {
    // Isotropic frame coordinates from the camera ray: y runs -1..1 bottom to
    // top, x spans the width at the same scale. Assumes the built-in 60 degree
    // field of view.
    let fw = normalize(-eye);
    let rt = normalize(cross(fw, vec3(0.0, 1.0, 0.0)));
    let up = cross(rt, fw);
    let p  = vec2(dot(ray, rt), dot(ray, up)) / (dot(ray, fw) * 0.57735027);

    let z  = t * evolve;
    let sr = scale / grain;
    let sb = scale * grain;

    // Turbulence per channel: the absolute value of two summed octaves. Its
    // zero set is the vein; `contrast` narrows it.
    let nr = abs(perlin(vec3(p * sr, z)) + 0.5 * perlin(vec3(p * sr * 2.1, z * 1.3 + 3.0)));
    let ng = abs(perlin(vec3(p * scale + vec2(5.2, 1.3), z + 7.0)) + 0.5 * perlin(vec3(p * scale * 2.1, z * 1.3 + 11.0)));
    let nb = abs(perlin(vec3(p * sb + vec2(-3.7, 8.1), z + 13.0)) + 0.5 * perlin(vec3(p * sb * 2.1, z * 1.3 + 17.0)));
    let vr = pow(max(1.0 - 2.0 * nr, 0.0), contrast);
    let vg = pow(max(1.0 - 2.0 * ng, 0.0), contrast);
    let vb = pow(max(1.0 - 2.0 * nb, 0.0), contrast);

    let y  = clamp(p.y / band, -1.0, 1.0);
    let fade = pow(cos(y * 1.5707963), 2.0);
    color = vec4(vec3(vr, vg, vb) * gains * fade, 1.0);
  }
}
