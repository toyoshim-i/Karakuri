// Six copies of a flat geometry, each laid on one face of a cube that tumbles
// about a tilted axis. Reads the xy square [-1, 1] as a face; z lifts off it
// along the face's outward normal.
// Ported from tmalib example/core/glow_cube.html, glow_cube4.html and
// glow_cube_attractor.html (the cube their textures are mapped onto).
//
//     cargo run -p karakuri-cli -- --set examples/face_streaks.kir,examples/cube_wrap.kir,examples/tint_strokes.kir

proc cube_wrap {
  kind    L2
  amplify 6

  consumes position, velocity

  // Half the cube's edge, in world units.
  param half : float [0.2, 4.0]  = 1.5

  // Turns per second about the tumble axis.
  param spin : float [-1.0, 1.0] = 0.05

  // Direction of the tumble axis.
  param axis : vec3 [-1.0, 1.0]  = vec3(1.0, 0.5, 1.0)

  deform {
    let p = position;
    let v = velocity;

    var fp = vec3(p.x, p.y, 1.0 + p.z);
    var fv = v;
    if copy == 1u {
      fp = vec3(0.0 - p.x, p.y, -1.0 - p.z);
      fv = vec3(0.0 - v.x, v.y, 0.0 - v.z);
    }
    if copy == 2u {
      fp = vec3(1.0 + p.z, p.y, 0.0 - p.x);
      fv = vec3(v.z, v.y, 0.0 - v.x);
    }
    if copy == 3u {
      fp = vec3(-1.0 - p.z, p.y, p.x);
      fv = vec3(0.0 - v.z, v.y, v.x);
    }
    if copy == 4u {
      fp = vec3(p.x, 1.0 + p.z, 0.0 - p.y);
      fv = vec3(v.x, v.z, 0.0 - v.y);
    }
    if copy == 5u {
      fp = vec3(p.x, -1.0 - p.z, p.y);
      fv = vec3(v.x, 0.0 - v.z, v.y);
    }

    let ax = normalize(axis + vec3(0.0001, 0.0, 0.0));
    let a  = t * spin * 6.2831853;

    position = rot_axis(fp * half, ax, a);
    velocity = rot_axis(fv * half, ax, a);
  }
}
