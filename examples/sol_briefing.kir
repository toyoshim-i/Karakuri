// A mission briefing map: contour lines of a hashed terrain over a fine coordinate grid,
// five waypoints joined by a dashed infiltration route that draws itself out over six
// seconds, a pulsing landing-zone marker at the end, three dashed red patrol zones, a
// reticle riding the head of the route and a column of message glyphs typing out on the
// right. Draws the whole frame and reads no geometry.

proc sol_briefing {
  kind  L4
  blend additive

  // Start of this piece's eight-second window inside a 32-second loop, in seconds;
  // negative runs it all the time.
  param start   : float [-1.0, 24.0] = -1.0

  fragment {
    // Isotropic frame coordinates: y runs -1..1 bottom to top. Assumes the
    // built-in 60 degree field of view.
    let fw = normalize(-eye);
    let rt = normalize(cross(fw, vec3(0.0, 1.0, 0.0)));
    let up = cross(rt, fw);
    let p  = vec2(dot(ray, rt), dot(ray, up)) / (dot(ray, fw) * 0.57735027);
    let tc   = srgb_to_linear(vec3(0.35, 0.95, 0.85));
    let grn  = srgb_to_linear(vec3(0.25, 1.0, 0.4));
    let red  = srgb_to_linear(vec3(1.0, 0.12, 0.1));
    let org  = srgb_to_linear(vec3(1.0, 0.55, 0.1));
    let yel  = srgb_to_linear(vec3(1.0, 0.92, 0.25));
    let cyan = srgb_to_linear(vec3(0.1, 0.85, 1.0));
    let dgrn = srgb_to_linear(vec3(0.03, 0.22, 0.1));
    let dtc  = srgb_to_linear(vec3(0.03, 0.16, 0.18));
    // Eight-second window inside a 32-second loop; a negative start disables it.
    let lt0  = mod(t, 32.0) - start;
    let lt   = mix(t, lt0, step(0.0, start));
    let win  = mix(1.0, step(0.0, lt0) * step(lt0, 8.0), step(0.0, start));
    let fade = mix(1.0, clamp(min(lt0, 8.0 - lt0) / 0.15, 0.0, 1.0), step(0.0, start)) * win;

    var c = vec3(0.0);

    // Terrain contours: a three-octave field cut into lines, every fifth one brighter.
    let hgt = fbm(vec3(p * 1.3 + vec2(3.0, 1.0), 0.0), 3) * 0.5 + 0.5;
    let hv  = hgt * 10.0;
    let wd  = fwidth(hv) * 1.1;
    let cl  = step(fract(hv), wd);
    let cm  = step(fract(hv * 0.2), wd * 0.2);
    c += tc * 0.35 * cl + tc * 0.5 * cm;
    c += dtc * 0.7 * step(hv, 3.0);

    // Coordinate grid with small crosses at the nodes.
    let gq   = p * 4.0;
    let gl   = max(step(abs(fract(gq.x + 0.5) - 0.5), 0.004), step(abs(fract(gq.y + 0.5) - 0.5), 0.004));
    c += tc * 0.1 * gl;

    // Route: waypoints on fixed places, drawn one segment after another.
    let prog = clamp(lt / 6.0, 0.0, 1.0) * 4.0;
    var route = 0.0;
    var head  = vec2(-1.2, -0.5);
    for s in 0..4 {
      let fs = float(s);
      let wa = vec2(-1.2 + fs * 0.62, -0.5 + 0.55 * sin(fs * 1.9 + 0.5));
      let wb = vec2(-1.2 + (fs + 1.0) * 0.62, -0.5 + 0.55 * sin((fs + 1.0) * 1.9 + 0.5));
      let f  = clamp(prog - fs, 0.0, 1.0);
      let ab = wb - wa;
      let hh = clamp(dot(p - wa, ab) / dot(ab, ab), 0.0, 1.0);
      let d  = length(p - wa - ab * hh);
      let dash = step(0.5, fract(hh * length(ab) / 0.05 - t * 2.0));
      route = max(route, step(d, 0.006) * step(hh, f) * dash);
      head = mix(head, wa + ab * f, vec2(step(0.001, f)));
    }
    c += yel * route;

    // Waypoints: squares that light as the route reaches them; the last is the landing zone.
    for w in 0..5 {
      let fw2 = float(w);
      let wp  = vec2(-1.2 + fw2 * 0.62, -0.5 + 0.55 * sin(fw2 * 1.9 + 0.5));
      let dq  = p - wp;
      let sq  = step(max(abs(dq.x), abs(dq.y)), 0.022);
      let lit = step(fw2, prog + 0.01);
      c += mix(dtc * 2.0, yel, vec3(lit)) * sq;
    }
    let lz  = p - vec2(1.28, -0.5 + 0.55 * sin(4.0 * 1.9 + 0.5));
    let lzr = 0.05 + 0.03 * step(0.5, fract(t * 1.5));
    c += grn * step(abs(length(lz) - lzr), 0.006) * step(3.9, prog + 0.01) + grn * step(length(lz), 0.012);

    // Patrol zones: three dashed red circles.
    for z in 0..3 {
      let fz = float(z);
      let zc = vec2(-0.55 + fz * 0.85, 0.25 + 0.3 * sin(fz * 2.7));
      let zd = length(p - zc);
      let za = fract(atan2(p.y - zc.y, p.x - zc.x) / 6.2831853 * 18.0 + t * 0.2);
      c += red * step(abs(zd - 0.2), 0.005) * step(0.5, za) * 0.9;
    }

    // Reticle at the head of the route.
    let rq  = p - head;
    let rl  = max(step(abs(rq.x), 0.003) * step(abs(rq.y), 0.06), step(abs(rq.y), 0.003) * step(abs(rq.x), 0.06));
    c += cyan * (rl + step(abs(length(rq) - 0.045), 0.004)) * step(0.01, lt);

    // Message column on the right.
    let bm_cx = floor((p.x - 1.0) / 0.034);
    let bm_rw = floor((0.8 - p.y) / 0.055);
    let bm_gx = floor(fract((p.x - 1.0) / 0.034) * 5.0);
    let bm_gy = floor(fract((0.8 - p.y) / 0.055) * 7.0);
    let bm_in = step(0.5, bm_gx) * step(bm_gx, 3.5) * step(0.5, bm_gy) * step(bm_gy, 5.5) * step(0.0, bm_cx) * step(0.0, bm_rw) * step(bm_rw, 8.0 - 1.0);
    let bm_bt = step(0.4, hash1(uint(bm_cx + 50.0) * 7919u + uint(bm_rw + 5.0) * 104729u + uint(bm_gx * 8.0 + bm_gy) * 31u + 3u));
    let bm_hit = bm_in * bm_bt * step(bm_cx, (lt - 0.5) * 16.0);

    c += tc * bm_hit * step(p.x, 1.62);
    c += tc * 0.5 * step(abs(p.x - 0.94), 0.003) * step(abs(p.y - 0.4), 0.42);
    let bax = abs(p.x);
    let bay = abs(p.y);
    c += tc * max(step(abs(bax - 1.72), 0.006) * step(bay, 0.94) * step(0.78, bay),
                    step(abs(bay - 0.94), 0.006) * step(bax, 1.74) * step(1.54, bax));

    color = vec4(c * fade, 1.0);

  }
}
