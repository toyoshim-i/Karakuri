// Scene one of the intrusion story, seconds 0 to 8: a system log types itself onto the
// left of the screen a line at a time while a map of nine network nodes lights up on the
// right, link by link, until the target node starts to blink inside a targeting bracket.
// Draws the whole frame and reads no geometry. Part of `intrusion_story.kset`.

proc intrusion_scan {
  kind  L4
  blend additive

  // Lines the log types per second.
  param typing : float [0.5, 8.0] = 3.5

  fragment {
    // Isotropic frame coordinates: y runs -1..1 bottom to top. Assumes the
    // built-in 60 degree field of view.
    let fw = normalize(-eye);
    let rt = normalize(cross(fw, vec3(0.0, 1.0, 0.0)));
    let up = cross(rt, fw);
    let p  = vec2(dot(ray, rt), dot(ray, up)) / (dot(ray, fw) * 0.57735027);

    // The story loops every 32 seconds in four scenes of eight; this one is scene 0.
    let lt   = mod(t, 32.0) - 0.0 * 8.0;
    let win  = step(0.0, lt) * step(lt, 8.0);
    let fade = clamp(min(lt, 8.0 - lt) / 0.3, 0.0, 1.0) * win;

    let cyan = srgb_to_linear(vec3(0.1, 0.9, 1.0));
    let mag  = srgb_to_linear(vec3(1.0, 0.15, 0.55));
    let red  = srgb_to_linear(vec3(1.0, 0.1, 0.1));
    let org  = srgb_to_linear(vec3(1.0, 0.6, 0.1));
    let grn  = srgb_to_linear(vec3(0.2, 1.0, 0.4));
    let dim  = srgb_to_linear(vec3(0.05, 0.25, 0.45));
    var c = vec3(0.0);

    // Log: twenty lines of blocky glyphs; the newest is bright and ends in a cursor.
    let rowh  = 0.07;
    let colw  = 0.03;
    let row   = floor((0.72 - p.y) / rowh);
    let shown = floor(lt * typing);
    let rin   = step(0.0, row) * step(row, 19.0) * step(row, shown);
    let hr    = hash2(uint(row + 40.0) * 6151u + 5u);
    let rlen  = floor(14.0 + hr.x * 30.0);
    let cxl   = floor((p.x + 1.62) / colw);
    let gx    = floor(fract((p.x + 1.62) / colw) * 5.0);
    let gy    = floor(fract((0.72 - p.y) / rowh) * 7.0);
    let ins   = step(0.5, gx) * step(gx, 3.5) * step(0.5, gy) * step(gy, 5.5);
    let bit   = step(0.4, hash1(uint(cxl + 100.0) * 7919u + uint(row + 100.0) * 104729u + uint(gx * 8.0 + gy) * 31u));
    let gap   = step(0.5, hash1(uint(cxl / 6.0) + uint(row) * 13u)) ;
    let inlen = step(0.0, cxl) * step(cxl, rlen);
    let newest = step(abs(row - shown), 0.5);
    let txt   = rin * inlen * ins * bit * mix(1.0, gap, 0.5);
    let ok    = step(0.85, hr.y);
    c += mix(grn * 0.5, mix(grn, vec3(1.0), vec3(0.6)), vec3(newest)) * txt * mix(1.0, 0.0, ok);
    c += org * txt * ok;
    let cur = step(abs(row - shown), 0.5) * step(abs(cxl - (rlen + 1.0)), 0.5) * step(0.5, fract(t * 2.0)) * step(gy, 6.5);
    c += grn * cur;

    // Network map: nine nodes on fixed hashed positions, each linked to the next and to
    // the one four along; a link and its node light in turn, and the sixth is the target.
    var net = vec3(0.0);
    for i in 0..9 {
      let fi  = float(i);
      let h0  = hash2(uint(i) * 8191u + 17u);
      let h1  = hash2(uint(mod(fi + 1.0, 9.0)) * 8191u + 17u);
      let h2  = hash2(uint(mod(fi + 4.0, 9.0)) * 8191u + 17u);
      let n0  = vec2(0.3 + 1.2 * h0.x, -0.6 + 1.2 * h0.y);
      let n1  = vec2(0.3 + 1.2 * h1.x, -0.6 + 1.2 * h1.y);
      let n2  = vec2(0.3 + 1.2 * h2.x, -0.6 + 1.2 * h2.y);
      let lit = step(fi * 0.6 + 1.0, lt);
      let d1  = n1 - n0;
      let d2  = n2 - n0;
      let q1  = clamp(dot(p - n0, d1) / dot(d1, d1), 0.0, 1.0);
      let q2  = clamp(dot(p - n0, d2) / dot(d2, d2), 0.0, 1.0);
      let l1  = step(length(p - n0 - d1 * q1), 0.004);
      let l2  = step(length(p - n0 - d2 * q2), 0.004);
      let nd  = step(max(abs(p.x - n0.x), abs(p.y - n0.y)), 0.026);
      net = max(net, dim * 0.6 * max(l1, l2) + cyan * max(l1, l2) * lit * 0.8);
      net = max(net, mix(dim, cyan, vec3(lit)) * nd);
      if i == 6 {
        let tgt   = step(6.0, lt);
        let blink = step(0.5, fract(t * 3.0));
        let box   = step(abs(max(abs(p.x - n0.x), abs(p.y - n0.y)) - 0.07), 0.005);
        let br    = step(0.6, fract(atan2(p.y - n0.y, p.x - n0.x) * 2.0 / 3.1415927 + 0.5)) * 0.0 + 1.0;
        net = max(net, org * tgt * (nd * blink + box * br));
      }
    }
    c += net * step(0.0, p.x - 0.1) * step(abs(p.y), 0.75);

    // A sweep line crossing the map once a second.
    let sx = 0.1 + fract(lt * 0.5) * 1.6;
    c += cyan * 0.35 * step(abs(p.x - sx), 0.004) * step(abs(p.y), 0.75);

    color = vec4(c * fade, 1.0);
  }
}
