// A closed surface built from a few thousand triangles that tears itself
// apart: waves of faces peel off as spinning shards, fly out along their
// normals and fall back into place, while the surface breathes between a
// spiked sphere and a twisted torus. Every triangle is three consecutive
// elements; each element rebuilds its whole face from `seed` so it can tumble
// the face about its own centre.
//
//     cargo run -p karakuri-cli -- --set examples/shard_bloom.kir,examples/shard_edges.kir
//
// `uv` carries the corner's barycentric coordinates within its face, (1,0),
// (0,1) or (0,0), so a renderer can find the face's edges. `tint` is the
// face's colour and `size` its heat: 0 at rest, 1 fully blown out.

proc shard_bloom {
  kind     L1
  topology triangles
  capacity [1536, 196608] = 9216

  // Base radius of the surface, in world units.
  param radius : float [0.5, 3.0] = 1.7

  // Seconds per morph between the spiked sphere and the twisted torus.
  param morph  : float [2.0, 30.0] = 8.0

  // How far shards fly, in world units, at full heat.
  param reach  : float [0.0, 4.0] = 1.6

  // Heat from the travelling peel wave.
  param peel   : float [0.0, 1.0] = 0.7

  // Heat from a hit; bind to an onset. The downbeat of every bar adds its own.
  param burst  : float [0.0, 1.0] = 0.0

  // Tumble speed of the whole body, in turns per second.
  param spin   : float [-0.5, 0.5] = 0.06

  // Hue of the body; faces spread a third of the wheel around it.
  param hue    : float [0.0, 1.0] = 0.55

  emit position, normal, uv, size, tint

  element {
    // Grid of quads, two faces each, sized from the capacity: twice as many
    // columns as rows.
    let nq   = capacity / 6u;
    let rows = uint(max(sqrt(float(nq) * 0.5), 1.0));
    let cols = nq / rows;
    let quad = seed / 6u;
    let tri  = (seed / 3u) % 2u;
    let crn  = seed % 3u;
    let face = seed / 3u;
    let live = step(float(quad), float(rows * cols) - 0.5);
    let qi   = float(quad % cols);
    let qj   = float(quad / cols);

    // Shape blend: 0 spiked sphere, 1 twisted torus, eased at both ends.
    let m = smoothstep(0.2, 0.8, 0.5 - 0.5 * cos(t * 6.2831853 / morph));

    // Evaluate the face's three corners; keep this element's own.
    var p0 = vec3(0.0);
    var p1 = vec3(0.0);
    var p2 = vec3(0.0);
    var cu = 0.0;
    var cv = 0.0;
    for k in 0..3 {
      let kk = uint(k);
      // Corner offsets: face 0 is (0,0) (1,0) (1,1); face 1 is (0,0) (1,1) (0,1).
      var du = 0.0;
      var dv = 0.0;
      if kk == 1u { du = 1.0; dv = float(tri); }
      if kk == 2u { du = 1.0 - float(tri); dv = 1.0; }
      let u = (qi + du) / float(cols);
      let v = (qj + dv) / float(rows);
      let a = u * 6.2831853;

      // Spiked sphere: latitude from pole to pole, radius rippled by a
      // travelling lobe pattern.
      let b  = v * 3.1415927;
      let sp = vec3(sin(b) * cos(a), cos(b), sin(b) * sin(a));
      let lobes = 1.0 + 0.28 * pow(abs(sin(a * 3.0 + t * 0.7) * sin(b * 4.0 - t * 0.5)), 3.0) * 2.0;
      let ps = sp * radius * lobes;

      // Twisted torus: the tube's cross-section is squeezed and turned as it
      // goes round.
      let c   = v * 6.2831853;
      let tw  = a * 1.5 + t * 0.8;
      let ex  = vec2(cos(c), sin(c) * 0.55);
      let rx  = vec2(cos(tw) * ex.x - sin(tw) * ex.y, sin(tw) * ex.x + cos(tw) * ex.y);
      let tube = radius * 0.42 * (1.0 + 0.2 * sin(a * 5.0 - t * 1.3));
      let rr  = radius * 1.05 + tube * rx.x;
      let pt  = vec3(rr * cos(a), tube * rx.y * 1.6, rr * sin(a));

      let pk = mix(ps, pt, vec3(m));
      if kk == 0u { p0 = pk; }
      if kk == 1u { p1 = pk; }
      if kk == 2u { p2 = pk; }
      if kk == crn { cu = u; cv = v; }
    }

    let cen = (p0 + p1 + p2) / 3.0;
    var own = p0;
    if crn == 1u { own = p1; }
    if crn == 2u { own = p2; }
    var n = normalize(cross(p1 - p0, p2 - p0) + vec3(0.00001));
    if dot(n, cen) < 0.0 { n = -n; }

    // Heat: a peel wave sweeping pole to pole and round the body, sharpened
    // so only a band is hot, plus the bar's downbeat and any bound hit.
    let fh    = hash3(face * 2654435761u + 17u);
    let wave  = pow(0.5 + 0.5 * sin(cv * 9.0 + cu * 6.2831853 * 2.0 - t * 1.7), 10.0) * peel;
    let down  = exp(-fract(beats / 4.0) * 16.0) * 0.8 * step(0.35, fh.z);
    let heat  = clamp(wave * (0.4 + 0.6 * fh.x) + down + burst * fh.y, 0.0, 1.0);

    // Shard: shrink toward the centre, tumble about a per-face axis, and fly
    // out along the normal.
    let ax    = normalize(fh - vec3(0.5) + vec3(0.0001));
    let turn  = heat * (2.0 + 6.0 * fh.y);
    let local = rot_axis((own - cen) * (1.0 - 0.35 * heat), ax, turn);
    let pos   = cen + local + n * heat * reach * (0.4 + 0.6 * fh.x);

    // Whole-body tumble.
    let body = rot_axis(pos, normalize(vec3(0.25, 1.0, 0.1)), t * spin * 6.2831853);
    position = body * live;
    normal   = rot_axis(n, normalize(vec3(0.25, 1.0, 0.1)), t * spin * 6.2831853);

    var bc = vec2(0.0);
    if crn == 0u { bc = vec2(1.0, 0.0); }
    if crn == 1u { bc = vec2(0.0, 1.0); }
    uv   = bc;
    size = heat;
    tint = hsv_to_rgb(vec3(fract(hue + 0.33 * (fh.x - 0.5) * 0.5 + cv * 0.15), 0.85, 1.0));
  }
}
