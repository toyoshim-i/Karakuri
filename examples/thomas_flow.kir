// Particles carried along Thomas' cyclically symmetric attractor: a lattice of
// looping channels that the flow threads through, the same under a turn that
// cycles the three axes. Colour follows the direction a particle sits in
// around the diagonal. The attractor's own state is carried in `normal`.
//
//     cargo run -p karakuri-cli -- --set examples/thomas_flow.kir,examples/tint_strokes.kir

proc thomas_flow {
  kind     L1
  topology points
  capacity [4096, 1048576] = 131072

  // Particles born per second, and seconds each one lives.
  param spawn_rate : float [0.0, 100000.0] = 18000.0
  param lifetime   : float [0.5, 20.0]     = 8.0

  // Attractor time per second of simulation time.
  param rate       : float [0.0, 12.0]     = 4.0

  // Damping; near 0.2 the flow is chaotic, lower values spread it through
  // more channels, higher ones collapse it to loops.
  param damp       : float [0.1, 0.3]      = 0.19

  // World units per attractor unit.
  param scale      : float [0.1, 1.0]      = 0.52

  // Hue offset, and saturation.
  param hue        : float [0.0, 1.0]      = 0.0
  param sat        : float [0.0, 1.0]      = 0.7

  // Turns per second of the whole shape about the vertical.
  param spin       : float [-0.5, 0.5]     = 0.025

  emit position, velocity, age, normal, tint

  spawn {
    let h = hash3(seed * 3u + 1u);
    normal   = (h - vec3(0.5)) * 8.0;
    position = vec3(0.0);
    velocity = vec3(0.0);
    age      = 0.0;
    tint     = vec3(0.0);
  }

  element {
    var p = normal;
    let h = dt * rate * 0.25;
    for i in 0..4 {
      let d = vec3(sin(p.y) - damp * p.x, sin(p.z) - damp * p.y, sin(p.x) - damp * p.z);
      p = p + d * h;
    }

    // The cube diagonal stands upright, so the three-fold symmetry faces the
    // viewer as a turn about the vertical.
    let q = rot_x(rot_z(p, 0.7853982), -0.6154797);
    let w = rot_y(q * scale, t * spin * 6.2831853);

    if age > 0.0 {
      velocity = (w - position) / max(dt, 0.0001);
    } else {
      velocity = vec3(0.0);
    }
    position = w;
    normal   = p;
    age      = age + dt;

    let turn = atan2(q.z, q.x) / 6.2831853;
    let fade = smoothstep(0.0, 0.6, age) * (1.0 - smoothstep(lifetime - 1.0, lifetime, age));
    tint = hsv_to_rgb(vec3(fract(hue + turn), sat, 1.0)) * fade;

    if age > lifetime {
      kill();
    }
  }
}
