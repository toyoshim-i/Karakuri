// A dark indigo field of writhing, branching electric filaments, cut into
// concentric rings on a logarithmic spacing that zoom endlessly outward from
// the centre like shock waves. The noise warps itself and turns slowly.
// Draws the whole frame and reads no geometry.
//
//     cargo run -p karakuri-cli -- --set examples/step_grid.kir,examples/plasma_rings.kir

proc plasma_rings {
  kind  L4
  blend additive

  // Rate at which the turbulence evolves and turns.
  param speed   : float [0.0, 1.0] = 0.15

  // How far the noise displaces its own lookup.
  param warp    : float [0.0, 2.0] = 0.8

  // Ring spacings the pattern zooms outward per second.
  param zoom    : float [0.0, 2.0] = 0.35

  // Rings per doubling of radius.
  param rings   : float [0.5, 6.0] = 2.0

  // Hue of the field.
  param hue     : float [0.0, 1.0] = 0.72

  // Thinness of the filaments; larger is finer and brighter at the core.
  param sharp   : float [1.0, 30.0] = 9.0

  fragment {
    // Isotropic frame coordinates from the camera ray: y runs -1..1 bottom to
    // top, x spans the width at the same scale. Assumes the built-in 60 degree
    // field of view.
    let fw = normalize(-eye);
    let rt = normalize(cross(fw, vec3(0.0, 1.0, 0.0)));
    let up = cross(rt, fw);
    let p  = vec2(dot(ray, rt), dot(ray, up)) / (dot(ray, fw) * 0.57735027);

    let z  = t * speed;
    let ra = z * 0.4;
    let q  = vec2(cos(ra) * p.x - sin(ra) * p.y, sin(ra) * p.x + cos(ra) * p.y) * 2.5;

    // Warp: two smooth noise fields displace the lookup of the ridged one.
    let w  = vec2(fbm(vec3(q, z), 3), fbm(vec3(q + vec2(5.2, 1.3), z + 4.0), 3));
    let s  = q + w * warp * 2.0;
    var f  = 0.0;
    var amp = 1.0;
    var fr  = 1.0;
    for o in 0..4 {
      f += abs(perlin(vec3(s * fr, z * 1.7 + float(o) * 3.1))) * amp;
      amp *= 0.55;
      fr  *= 2.1;
    }

    // Filaments are where the ridged sum is smallest.
    let e  = pow(clamp(1.0 - f, 0.0, 1.0), sharp) * 4.0;

    // Log-polar rings, looping outward.
    let r  = max(length(p), 0.0001);
    let lr = log2(r) * rings - t * zoom;
    let ring = pow(0.5 + 0.5 * cos(lr * 6.2831853), 3.0) * smoothstep(0.02, 0.25, r);

    let base = hsv_to_rgb(vec3(hue, 0.85, 1.0));
    let lit  = e * (0.15 + 0.85 * ring);
    let c    = base * (0.02 + 0.05 * ring) + base * lit * 0.6 + vec3(lit * lit * 0.1);
    color = vec4(c, 1.0);
  }
}
