// One small six-armed asterisk per element, `size` world units in half-width,
// sized in perspective and coloured `tint`. An element of `size` 0 draws nothing.
// Ported from tmalib ext/mv/frame/astalight/shaders.html.
//
//     cargo run -p karakuri-cli -- --set examples/aster_field.kir,examples/aster_sprites.kir

proc aster_sprites {
  kind  L4
  blend additive

  consumes position, tint, size

  // Multiplier on the half-width each element carries in `size`.
  param scale    : float [0.0, 8.0] = 2.2

  // Width of an arm, as a fraction of the sprite's half-width.
  param arm      : float [0.02, 0.6] = 0.16

  // Brightness multiplier on `tint`.
  param exposure : float [0.0, 8.0] = 0.9

  vertex {
    let c  = camera * vec4(position, 1.0);
    let cu = camera * vec4(position + vec3(0.0, size * scale, 0.0), 1.0);

    clip       = c;
    point_rate = abs(cu.y / cu.w - c.y / c.w);
  }

  fragment {
    let q      = point_coord * 2.0 - 1.0;
    let r      = length(q);
    let across = abs(sin(atan2(q.y, q.x) * 3.0)) * r;
    let a      = (1.0 - smoothstep(arm * 0.5, arm, across)) * (1.0 - smoothstep(0.6, 1.0, r));

    color = vec4(tint * exposure, a);
  }
}
