// A broken video feed: mostly a calm, warm, scanlined picture with a slow
// colour drift down the lines, grain and a bright tube centre, until without
// warning a burst tears it apart for a few frames — red and blue split
// sideways, horizontal bands shear off, white static floods in and the frame
// breaks into wide vertical blocks. Two random gates decide every tick whether
// the picture holds or jumps: one drives the split, the static and the tearing
// together, the other the width of the blocks. A few dark vertical scratches
// wander across the frame and the whole image can shake by a few pixels each
// tick, like a signal that cannot hold sync.
// Ported from tmalib ext/mv/effect/noise, driven the way
// example/majvj_effects/noise.html drives it with two
// ext/mv/misc/automator `randomly_gated_random`s.
//
//     cargo run -p karakuri-cli -- --set examples/step_grid.kir,examples/cyber_glitch.kir,examples/wired_static.kir --capacity 256

proc wired_static {
  kind L5

  // Automation ticks per second; each tick every gate is rolled once.
  param rate        : float [1.0, 120.0] = 60.0

  // Chance per tick that the burst gate rolls a new value; otherwise it holds.
  param burst_roll  : float [0.0, 1.0] = 0.4
  // Chance that a new burst value is calm (zero) rather than a burst.
  param burst_calm  : float [0.0, 1.0] = 0.9
  // Largest burst. A burst `n` shifts red and blue by `n` of the frame width,
  // adds `3n` of white static and raises the tear level by `10n`.
  param burst       : float [0.0, 0.2] = 0.1

  // Chance per tick that the block gate rolls a new width; otherwise it holds.
  param block_roll  : float [0.0, 1.0] = 0.2
  // Chance that a new block width is calm (no blocking).
  param block_calm  : float [0.0, 1.0] = 0.8
  // Widest block, as a fraction of the frame height.
  param block       : float [0.0, 0.2] = 0.089

  // Forces a burst and a block width while high. Bind to an onset.
  param kick        : float [0.0, 1.0] = 0.0

  // Resting sideways shift of red and blue against green, as a fraction of the
  // frame width.
  param split       : float [0.0, 0.05] = 0.005
  // Saturation kept from the source; 0 is grey, 1 is unchanged.
  param saturation : float [0.0, 2.0] = 1.0
  // Red's saturation relative to green and blue.
  param red         : float [0.0, 2.0] = 1.2
  // Pull toward sepia after the saturation change: 0 keeps the channels even,
  // 1 weighs them 1.0, 0.7 and 0.4.
  param sepia       : float [0.0, 1.0] = 1.0

  // Resting level of the white static, redrawn every tick.
  param white       : float [0.0, 1.0] = 0.1
  // Level of the pink static: short bright runs along each line.
  param pink        : float [0.0, 1.0] = 0.2
  // Level of the fine grain that stays in place and flickers.
  param grain       : float [0.0, 1.0] = 0.01
  // Takes blue out of all three, turning the static yellow; 0 is white.
  param yellow      : float [0.0, 1.0] = 0.0

  // Depth of the scanline darkening; 0 removes the lines.
  param scanline    : float [0.0, 1.0] = 0.5
  // Strength of the per-line colour drift; 0 keeps colours even.
  param drift       : float [0.0, 1.0] = 1.0
  // Resting tear level: how much of the frame height shears off at rest.
  param tear        : float [0.0, 3.0] = 0.3
  // Tube shading: every texel is multiplied by `tube_base` plus `tube_gain`
  // times x(1-x)y(1-y), which is 1/16 at the centre and 0 at the edges.
  // 1 and 0 leave the picture flat.
  param tube_base   : float [0.0, 2.0] = 0.1
  param tube_gain   : float [0.0, 64.0] = 48.0
  // Depth of the brightness flicker of the tube; 0 is steady.
  param flicker     : float [0.0, 1.0] = 0.4
  // Number of dark vertical scratches, up to 5; a fraction fades the last one.
  param scratches   : float [0.0, 5.0] = 3.0
  // Largest whole-frame shake per tick, as a fraction of the frame height.
  param jitter      : float [0.0, 0.02] = 0.0

  frame {
    // One tick of the automation. Offset so that looking back never goes
    // below zero.
    let k = uint(max(floor(t * rate), 0.0)) + 64u;

    // Each gate holds its last value until a tick rolls under its chance; the
    // most recent such tick within the last 32 decides the value.
    var n = 0.0;
    var n_found = 0.0;
    var cw = 0.0;
    var cw_found = 0.0;
    for i in 0..32 {
      let j = (k - uint(i)) * 8u;
      if n_found < 0.5 {
        if hash1(j) < burst_roll {
          n_found = 1.0;
          if hash1(j + 1u) >= burst_calm {
            n = burst * hash1(j + 2u);
          }
        }
      }
      if cw_found < 0.5 {
        if hash1(j + 3u) < block_roll {
          cw_found = 1.0;
          if hash1(j + 4u) >= block_calm {
            cw = block * hash1(j + 5u);
          }
        }
      }
    }
    let kj = k * 8u;
    n  = max(n, kick * burst * (0.5 + 0.5 * hash1(kj + 6u)));
    cw = max(cw, kick * block * (0.3 + 0.7 * hash1(kj + 7u)));

    // Shake: one random offset for the whole frame this tick.
    let shake = (hash2(kj + 9u) - vec2(0.5)) * 2.0 * frame_step(jitter);
    let at    = point_coord + shake;
    let fy    = 1.0 - at.y;

    // Per-line mask: scanlines, colour drift, and the tear.
    let wave = (sin(fy * 1130.97) + 1.0) * 0.5;
    let scan = 1.0 - scanline + wave * scanline;
    let tc   = t * 0.1;
    let tint_n = vec3(perlin(vec3(fy * 8.0, tc, 0.5)),
                      perlin(vec3(fy * 8.0, tc, 0.7)),
                      perlin(vec3(fy * 8.0, tc, 0.3)));
    let lane = scan * mix(vec3(1.0), (vec3(1.0) + tint_n) * 0.5, vec3(drift));

    // A band shears where a coarse noise passes the threshold; the shift is
    // quantised to 1/255 of the width, and every line carries a faint offset.
    let tr    = t * 5.0;
    let n1    = perlin(vec3(fy * 256.0, tr, 2.27));
    let n2    = perlin(vec3(fy * 32.0, tr, 6.23));
    let torn  = step(1.0 - tear - n * 10.0, n2) * (1.0 + n1);
    let shear = floor((torn + (1.0 + n2) * 0.1) * 7.0) / 255.0;

    // Blocks: the sample column is quantised to `cw` of the frame height,
    // sampled at the block's centre.
    let bw = max(frame_step(cw).x, 0.000001);
    var x  = at.x - shear;
    if cw > 0.0001 {
      x = (floor(x / bw) + 0.5) * bw;
    }

    // Channel split, then saturation and sepia, in display space.
    let sh = split + n;
    let r  = tap(src, vec2(x - sh, at.y)).x;
    let c  = tap(src, vec2(x, at.y));
    let b  = tap(src, vec2(x + sh, at.y)).z;
    let rgb  = linear_to_srgb(max(vec3(r, c.y, b), vec3(0.0)));
    let luma = dot(rgb, vec3(0.299, 0.587, 0.114));
    let keep = vec3(saturation * red, saturation, saturation);
    let aged = (vec3(luma) + (rgb - vec3(luma)) * keep) * mix(vec3(1.0), vec3(1.0, 0.7, 0.4), vec3(sepia));

    // Static on a 720-row grid. White is fresh per texel per tick; pink is a
    // run along the row with 1/i weights, wrapped into 0..1; both jump to a
    // new random place each tick. The slow grain stays put and flickers.
    let cell = frame_step(0.0013889);
    let px   = floor(at / cell);
    let q    = px + floor(hash2(kj + 11u) * 4096.0);
    let row  = uint(q.y) * 7919u + kj * 13u;
    let hw    = hash1(uint(q.x) * 31u + row);
    var run   = 0.521;
    for i in 1..13 {
      let fi = float(i);
      run += hash1(uint(q.x - fi + 64.0) * 31u + row + 5u) / (2.0 * fi);
    }
    let pk  = fract((run + 1.0) * 0.5);
    let pg    = px / 3.0;
    let slow1 = (perlin(vec3(pg, 0.3)) + 1.0) * 0.5;
    let slow2 = (perlin(vec3(pg, 0.6)) + 1.0) * 0.5;
    let s     = (sin(t * 100.0) + 1.0) * 0.5;
    let noise = hw * (white + n * 3.0) + pk * pink + mix(slow2, slow1, s) * grain;

    var pic = aged * lane + lane * (shear * 2.0) + vec3(1.0, 1.0, 1.0 - yellow) * noise;

    // Tube: bright centre, dark edges, flickering.
    let g     = point_coord * (vec2(1.0) - point_coord);
    let flash = 1.0 + perlin(vec3(0.1, 0.1, t * 100.0)) * flicker;
    pic = pic * (tube_base + g.x * g.y * tube_gain * flash);

    // Scratches: 1-texel lines that darken by 30%, each wandering on its own noise.
    for i in 0..5 {
      let fi = float(i);
      let sx = 0.5 + perlin(vec3(t, fi * 3.33, fi * 7.77))
                   + perlin(vec3(t * 100.0, fi * 4.0, fi * 8.0)) * 0.01;
      let on = clamp(scratches - fi, 0.0, 1.0);
      pic = pic * (1.0 - 0.3 * on * (1.0 - smoothstep(0.0, cell.x, abs(point_coord.x - sx))));
    }

    color = vec4(srgb_to_linear(max(pic, vec3(0.0))), c.w);
  }
}
