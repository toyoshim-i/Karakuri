// High-density mechanical blueprint renderer for `kowloon_cyberspace`.
// Uses `blend weighted` (Order-Independent Transparency) so outer Kowloon
// greeble cages, radiator fins, and ventilation louvers partially occlude the
// inner reactor core instead of washing out to white under additive overlap.

proc kowloon_wire_strokes {
  kind  L4
  blend weighted

  consumes position, velocity, tint

  param width     : float [0.0007, 0.025] = 0.0014
  param exposure  : float [0.1, 8.0]  = 1.15
  param opacity   : float [0.05, 1.0] = 0.72
  param core_hot  : float [0.0, 4.0]  = 0.55
  param node_glow : float [0.0, 3.0]  = 0.65
  param falloff   : float [0.5, 8.0]  = 2.6

  vertex {
    clip   = camera * vec4(position, 1.0);
    clip_b = camera * vec4(position - velocity, 1.0);

    point_rate = width;
  }

  fragment {
    let across = abs(point_coord.y * 2.0 - 1.0);
    let along  = point_coord.x;

    // Fine mechanical line profile
    let edge = pow(max(0.0, 1.0 - across), falloff);
    let core = pow(max(0.0, 1.0 - across), falloff * 4.0);

    // Brighten vertex rivets at segment ends
    let end_dist = min(along, 1.0 - along) * 2.0;
    let junction = pow(max(0.0, 1.0 - end_dist * 4.0), 2.0) * node_glow;

    let col = tint * exposure * (1.0 + junction) + vec3(core * core_hot);
    let alpha = clamp(edge * opacity * (0.85 + 0.3 * junction), 0.0, 1.0);

    color = vec4(col, alpha);
  }
}
