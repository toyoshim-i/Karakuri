// Two light ribbons racing each other through space, and the two points a
// camera flies them with. The flight never ends: z is measured from where the
// flight is now, `speed * t`, so the numbers stay small however long it runs.
//
// Each ribbon has a head whose position is a function of time, H(u). The head
// swoops across and up and down a winding corridor, spirals round the other
// head, and runs ahead of or behind it on slow swings, so the two keep passing
// each other. A ribbon is the head's own recent history: the point `a` of the
// way down the tail is H(t - a * trail).
//
// Elements 0, 1 and 2 are the camera's: the eye, the target, and the eye again,
// a triangle with no area and no tint, so nothing is drawn. The eye is where
// one head was `follow` seconds ago, lifted a little off the trail; the target
// is that head now, pulled toward the other by at most 1.5 units. Which head is
// followed crossfades every twenty seconds or so. `ribbon_eye.kir` reads them
// as `subject[0u]` and `subject[1u]`: this procedure has no spawn and no kill,
// so an element's age rank is its seed.
//
// Elements [3, 6147) are the ribbons: 2 ribbons * 512 segments * 6 corners.
// Elements [6147, 18432) are 4095 star streaks, 3 corners each.
// uv.x is the distance from the head (0) to the tail (1) on a ribbon and 2.0 on
// a star; uv.y is the side, -1 or +1. size is the stripe phase on a ribbon and
// the head-to-tail fade on a star. tint carries the distance haze.
//
//     cargo run -p karakuri-cli -- --store /tmp/ribbon-chase --take-in examples/ribbon_chase.kset
//     cargo run -p karakuri-cli -- --store /tmp/ribbon-chase --load-set ribbon_chase

proc ribbon_chase {
  kind     L1
  topology triangles
  capacity [18432, 18432] = 18432

  // Flight speed along the corridor in world units per second.
  param speed  : float [0.0, 30.0] = 11.0

  // How far the heads swing ahead of and behind each other.
  param chase  : float [0.0, 1.0] = 0.7

  // How far the heads roam across the corridor.
  param roam   : float [0.0, 2.0] = 1.0

  // Ribbon width, and its length as seconds of history.
  param width  : float [0.05, 1.0] = 0.22
  param trail  : float [0.5, 5.0] = 2.2

  // How hard the corridor bends.
  param swing  : float [0.0, 2.0] = 1.0

  // Seconds the eye rides behind the head it follows.
  param follow : float [0.3, 3.0] = 0.9

  emit position, uv, tint, size

  element {
    let is_ribbon = seed >= 3u && seed < 6147u;
    var fr = 0.0;
    var a = 0.0;
    var dv = 0.0;
    if is_ribbon {
      let local = seed - 3u;
      let quad = local / 6u;
      let tri = (local / 3u) % 2u;
      let corner = local % 3u;
      var du = 0.0;
      if corner == 1u { du = 1.0; dv = float(tri); }
      if corner == 2u { du = 1.0 - float(tri); dv = 1.0; }
      fr = float(quad / 512u);
      a = (float(quad % 512u) + du) / 512.0;
    }

    // Six evaluations of H(u) for ribbon k, at u = t + rel.
    //   0, 1: both heads now.  2, 3: both heads `follow` seconds ago.
    //   4, 5: this element's point on its ribbon, and a step later for the tangent.
    var ha = vec3(0.0);
    var hb = vec3(0.0);
    var la = vec3(0.0);
    var lb = vec3(0.0);
    var p0 = vec3(0.0);
    var p1 = vec3(0.0);
    for j in 0..6 {
      var rel = 0.0;
      var k = 0.0;
      if j == 1 { k = 1.0; }
      if j == 2 { rel = -follow; }
      if j == 3 { rel = -follow; k = 1.0; }
      if j == 4 { rel = -a * trail; k = fr; }
      if j == 5 { rel = 0.02 - a * trail; k = fr; }
      let u = t + rel;

      // The heads' separation is dominated by the first term, which changes
      // sign every ten seconds or so: that is the overtaking.
      let lead = chase * (6.0 * sin(u * 0.29) * (1.0 - 2.0 * k)
        + 3.0 * sin(u * (0.71 - 0.18 * k) + 1.0 + k));
      let sa = speed * u + lead;
      let cx = swing * (9.0 * sin(sa * 0.031) + 4.0 * sin(sa * 0.083 + 1.3));
      let cy = swing * (6.0 * sin(sa * 0.047 + 0.7) + 3.0 * cos(sa * 0.101));

      // Wide swoops, plus a tight spiral with the heads half a turn apart so
      // they wind round each other when their swoops bring them together.
      let spin = u * 2.1 + k * 3.1415927;
      let ox = roam * (5.0 * sin(u * (0.37 + 0.08 * k) + 2.4 * k)
        + 2.5 * sin(u * (0.93 - 0.11 * k) + 0.6 + k) + 1.3 * cos(spin));
      let oy = roam * (3.8 * sin(u * (0.43 - 0.05 * k) + 1.1 + 1.9 * k)
        + 2.0 * cos(u * (0.81 + 0.13 * k) + 2.2 * k) + 1.3 * sin(spin));

      let h = vec3(cx + ox, cy + oy, speed * rel + lead);
      if j == 0 { ha = h; }
      if j == 1 { hb = h; }
      if j == 2 { la = h; }
      if j == 3 { lb = h; }
      if j == 4 { p0 = h; }
      if j == 5 { p1 = h; }
    }

    // The camera's two points. The target is never closer than six units
    // ahead of the eye, so the view cannot turn round.
    let w = smoothstep(-0.4, 0.4, sin(t * 0.15));
    let vantage = mix(la, lb, vec3(w)) + vec3(sin(t * 0.23) * 1.8, 1.2 + sin(t * 0.31) * 0.9, 0.0);
    let followed = mix(ha, hb, vec3(w));
    let pull = mix(hb, ha, vec3(w)) - followed;
    let aim = followed + pull * (0.3 * min(1.0, 5.0 / max(length(pull), 0.001)));
    let target = vec3(aim.x, aim.y, max(aim.z, vantage.z + 6.0));

    if seed < 3u {
      position = vantage;
      if seed == 1u { position = target; }
      uv = vec2(0.0);
      tint = vec3(0.0);
      size = 0.0;
    } else if is_ribbon {
      // Flat band across the tangent, twisting as the head did.
      let tang = normalize(p1 - p0 + vec3(0.0, 0.0, 0.0001));
      let n0 = normalize(cross(tang, vec3(0.0, 1.0, 0.0)) + vec3(0.0001));
      let b0 = cross(tang, n0);
      let phi = (t - a * trail) * 1.3 + fr * 1.7;
      let side = n0 * cos(phi) + b0 * sin(phi);

      // Pointed head, long tapering tail.
      let wid = width * smoothstep(0.0, 0.035, a) * pow(1.0 - a, 0.6);
      position = p0 + side * (dv * 2.0 - 1.0) * wid;

      uv = vec2(a, dv * 2.0 - 1.0);
      let haze = exp(-length(position - vantage) * 0.012);
      tint = mix(vec3(0.1, 0.55, 1.0), vec3(1.0, 0.18, 0.6), vec3(fr)) * haze;
      // Stripes ride the ribbon from head to tail.
      size = fract(t * 1.5) - a * trail * 1.5;
    } else {
      let star = (seed - 6147u) / 3u;
      let corner = seed % 3u;
      let h = hash3(star);
      let g = hash3(star + 7919u);

      // Fixed in space across, wrapped along the flight over 110 units
      // around the eye.
      let ahead = fract(h.z - (speed * t + vantage.z) / 110.0) * 110.0 - 20.0;
      var p = vec3((h.x * 2.0 - 1.0) * 70.0, (h.y * 2.0 - 1.0) * 50.0, vantage.z + ahead);

      let d = p - vantage;
      let across = normalize(cross(normalize(d), vec3(0.0, 0.0, 1.0)) + vec3(0.0001));
      let thick = 0.012 + 0.0012 * length(d);
      let streak = speed * 0.09 * (0.5 + g.x);

      var side = 1.0;
      size = 1.0;
      if corner == 0u { p = p + across * thick; }
      if corner == 1u { p = p - across * thick; side = -1.0; }
      if corner == 2u { p = p + vec3(0.0, 0.0, streak); side = 0.0; size = 0.0; }
      position = p;

      let fade = smoothstep(90.0, 65.0, ahead) * smoothstep(-20.0, -12.0, ahead);
      let hue = mix(vec3(0.6, 0.75, 1.0), vec3(1.0, 0.8, 0.55), vec3(step(0.7, g.y)));
      tint = hue * (0.5 + 3.0 * pow(g.z, 6.0)) * fade;
      uv = vec2(2.0, side);
    }
  }
}
