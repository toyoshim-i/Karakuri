// Symmetrical kaleidoscopic reflection and tunnel fold for VR immersion.
// Folds the incoming visual into N-fold radial symmetry with optional tunnel
// depth rings, spiral twist, beat-synced breathing, and seamless mirror tiling.
//
// Can be slotted on any deck layer or placed into the master chain to transform
// flat visuals and 3D scenes into kaleidoscopic mandala environments.

proc vr_kaleidoscope {
  kind L5

  // Number of symmetry facets (wedges) around the centre.
  param facets   : float [3.0, 24.0] = 6.0

  // Alternating mirror fold (1.0) versus simple cyclic repeat (0.0).
  param mirror   : float [0.0, 1.0] = 1.0

  // Rotation in turns per beat.
  param spin     : float [-2.0, 2.0] = 0.1

  // Magnification scale from the centre.
  param zoom     : float [0.2, 4.0] = 1.2

  // Tunnel depth: creates concentric radial tunnel perspective rings.
  param tunnel   : float [0.0, 1.0] = 0.0

  // Spiral swirl twist: twists the kaleidoscope arms radially.
  param twist    : float [-2.0, 2.0] = 0.0

  // Beat-synced breathing pulse expanding and contracting the mandala.
  param pulse    : float [0.0, 1.0] = 0.2

  // Seamless mirrored tiling across the field.
  param tile     : float [0.0, 1.0] = 1.0

  // Soft edge vignette falloff.
  param vignette : float [0.0, 1.0] = 0.2

  frame {
    let fs     = frame_step(1.0);
    let aspect = fs.y / fs.x;

    // Beat pulse modulation.
    let beat_phase = fract(max(beats, 0.0));
    let beat_bump  = pulse * exp(-beat_phase * 4.0) * 0.25;
    let cur_zoom   = zoom * (1.0 + beat_bump);

    // Centered coordinates.
    let p = vec2((point_coord.x * 2.0 - 1.0) * aspect, 1.0 - point_coord.y * 2.0) / cur_zoom;
    let r = length(p);

    // Base rotation and spiral twist based on radius.
    let rot = (spin * beats + twist * r * 0.5) * 6.2831853;
    let a   = (atan2(p.y, p.x) - rot) % 6.2831853;
    let a_norm = (a + 6.2831853) % 6.2831853;

    // Kaleidoscope wedge division and reflection.
    let n     = max(2.0, floor(facets + 0.5));
    let wedge = 6.2831853 / n;
    let idx   = floor(a_norm / wedge);
    var phi   = a_norm - idx * wedge;
    if mirror > 0.5 && idx % 2.0 >= 1.0 {
      phi = wedge - phi;
    }

    // Tunnel logarithmic depth warp.
    let r_tunnel = log(max(r, 0.01)) * 0.5 - beats * 0.25;
    let r_final  = mix(r, fract(r_tunnel), tunnel);

    let q = r_final * vec2(cos(phi), sin(phi));

    // Convert folded coordinates back to frame coordinates.
    let coord_raw = vec2(q.x / aspect * 0.5 + 0.5, 0.5 - q.y * 0.5);

    // Seamless mirror tiling vs clamped frame.
    let coord_tiled = abs(fract(coord_raw * 0.5 + 0.5) * 2.0 - 1.0);
    let at          = mix(clamp(coord_raw, vec2(0.0), vec2(1.0)), coord_tiled, vec2(tile));

    let in_bounds = step(0.0, coord_raw.x) * step(coord_raw.x, 1.0) * step(0.0, coord_raw.y) * step(coord_raw.y, 1.0);
    let mask      = mix(in_bounds, 1.0, tile);

    let vig = smoothstep(1.2, max(0.2, 1.2 - vignette * 0.6), r / aspect);

    let s = tap(src, at);
    color = s * (mask * vig);
  }
}
