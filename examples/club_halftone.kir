// Club-flyer pop graphics on the beat: a sunburst in two loud colours turns
// behind a halftone wash, a black tape of scrolling stripes cuts across the
// frame, a speaker cone with heavy black outlines pumps at the centre, rings
// shoot outward on every kick, and the whole palette changes each bar. The
// frame punches in on the beat. Draws the whole frame and reads no geometry.
//
//     cargo run -p karakuri-cli -- --set examples/step_grid.kir,examples/club_halftone.kir --capacity 256

proc club_halftone {
  kind  L4
  blend additive

  // Size of the punch-in on each beat.
  param punch  : float [0.0, 0.3] = 0.08

  // Halftone cell size, in frame half-heights.
  param dots   : float [0.02, 0.12] = 0.05

  // Tilt of the stripe tape, in radians.
  param tilt   : float [-1.0, 1.0] = -0.35

  // Speaker size, in frame half-heights.
  param cone   : float [0.1, 0.6] = 0.32

  // Extra punch from a hit. Bind to an onset.
  param kick   : float [0.0, 1.0] = 0.0

  fragment {
    // Isotropic frame coordinates: y runs -1..1 bottom to top. Assumes the
    // built-in 60 degree field of view.
    let fw = normalize(-eye);
    let rt = normalize(cross(fw, vec3(0.0, 1.0, 0.0)));
    let up = cross(rt, fw);
    let p0 = vec2(dot(ray, rt), dot(ray, up)) / (dot(ray, fw) * 0.57735027);

    let bt   = fract(beats);
    let hit  = max(exp(-bt * 7.0), kick);
    let p    = p0 * (1.0 - punch * hit);
    let bar  = floor(beats / 4.0);
    let ink  = vec3(0.004);

    // Palette: four loud colours, three of them drawn per bar.
    let hb   = hash3(uint(bar + 1000.0) * 7919u + 3u);
    let i0   = floor(hb.x * 4.0);
    let i1   = mod(i0 + 1.0 + floor(hb.y * 3.0), 4.0);
    let i2   = mod(i1 + 1.0 + floor(hb.z * 2.0), 4.0);
    let pink = srgb_to_linear(vec3(1.0, 0.1, 0.55));
    let lemon = srgb_to_linear(vec3(1.0, 0.9, 0.05));
    let cyan = srgb_to_linear(vec3(0.0, 0.85, 1.0));
    let violet = srgb_to_linear(vec3(0.55, 0.2, 1.0));
    let a  = mix(mix(pink, lemon, vec3(step(0.5, i0))), mix(cyan, violet, vec3(step(2.5, i0))), vec3(step(1.5, i0)));
    let b  = mix(mix(pink, lemon, vec3(step(0.5, i1))), mix(cyan, violet, vec3(step(2.5, i1))), vec3(step(1.5, i1)));
    let cc = mix(mix(pink, lemon, vec3(step(0.5, i2))), mix(cyan, violet, vec3(step(2.5, i2))), vec3(step(1.5, i2)));

    // Sunburst: sixteen rays that step a sixteenth of a turn on each beat.
    let ang  = atan2(p.y, p.x) / 6.2831853;
    let spin = (floor(beats) + smoothstep(0.0, 0.25, bt)) / 32.0;
    let ray16 = step(0.5, fract(ang * 16.0 + spin));
    var c = mix(a, b, vec3(ray16));

    // Halftone: a 45 degree dot screen in the third colour, the dots growing
    // along a sweep that rolls with the bar.
    let hq  = vec2(p.x + p.y, p.y - p.x) * 0.70710678 / dots;
    let hf  = fract(hq) - vec2(0.5);
    let ramp = 0.5 + 0.5 * sin(p.x * 1.6 - p.y * 0.8 + beats * 0.785);
    let rad  = 0.55 * ramp;
    let dot1 = 1.0 - smoothstep(rad - 0.04, rad + 0.04, length(hf));
    c = mix(c, cc, vec3(dot1));

    // Tape: a black band across the frame carrying stripes that scroll two
    // widths per beat, outlined in the first colour.
    let ct = cos(tilt);
    let st = sin(tilt);
    let tv = st * p.x + ct * p.y + 0.55;
    let tu = ct * p.x - st * p.y;
    let intape = step(abs(tv), 0.1);
    let stripes = step(0.5, fract((tu + tv) * 7.0 - beats * 2.0));
    let tape = mix(ink, mix(lemon, ink, vec3(stripes)), vec3(step(abs(tv), 0.075)));
    c = mix(c, tape, vec3(intape));
    c = mix(c, ink, vec3(step(abs(abs(tv) - 0.1), 0.008)));

    // Kick rings: a pair of outlined rings launched from the centre each
    // beat, thinning as they travel.
    let r  = length(p);
    let kr = cone + bt * 1.6;
    let kw = 0.03 * (1.0 - bt);
    let kring = step(abs(r - kr), kw) + step(abs(r - kr * 0.8), kw * 0.6);
    c = mix(c, vec3(1.0), vec3(clamp(kring, 0.0, 1.0)));

    // Speaker: outer surround, cone and dust cap, in flat colours with heavy
    // black outlines; it swells on the hit.
    let cr   = cone * (1.0 + 0.12 * hit);
    let face = 1.0 - step(cr, r);
    let body = mix(mix(ink, b, vec3(step(cr * 0.82, r))), a, vec3(step(r, cr * 0.72)));
    let conel = step(0.5, fract(r / cr * 6.0 - beats * 0.5)) * 0.15 * step(cr * 0.35, r) * step(r, cr * 0.72);
    let capc = mix(body * (1.0 - conel), cc, vec3(step(r, cr * 0.33)));
    let shine = step(length(p - vec2(-0.3, 0.3) * cr), cr * 0.09);
    c = mix(c, mix(capc, vec3(1.0), vec3(shine)), vec3(face));
    let outline = step(abs(r - cr), 0.012) + step(abs(r - cr * 0.82), 0.008)
                + step(abs(r - cr * 0.72), 0.01) + step(abs(r - cr * 0.33), 0.01);
    c = mix(c, ink, vec3(clamp(outline, 0.0, 1.0)));

    // Downbeat flash, then a black frame border.
    let down = step(mod(floor(beats), 4.0), 0.5) * exp(-bt * 10.0);
    c = mix(c, vec3(1.0) - c, vec3(down * 0.9));
    let edge = step(1.76, abs(p0.x)) + step(0.96, abs(p0.y));
    c = mix(c, ink, vec3(clamp(edge, 0.0, 1.0)));

    color = vec4(c * 0.9, 1.0);
  }
}
