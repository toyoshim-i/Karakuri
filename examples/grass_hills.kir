// A letterboxed low flight over rolling green hills furred with swaying grass
// that pales at the tips; distant hills fade into a grey-blue haze, a warm low
// sun sits to one side and throws flare blobs when the camera turns toward it,
// and the camera banks round a looping path under a graded, vignetted look.
// Reads `ray` against a camera facing negative z.
//
//     cargo run -p karakuri-cli -- --set examples/step_grid.kir,examples/room_eye.kir,examples/grass_hills.kir --param turn=0

proc grass_hills {
  kind  L4
  blend additive

  // Angular speed round the flight loop, in radians per second.
  param flight  : float [0.0, 0.3] = 0.05

  // Camera height above the ground in world units.
  param height  : float [0.3, 6.0] = 2.2

  // How far the grass sways in the wind.
  param wind    : float [0.0, 2.0] = 0.6

  // Grass blades per world unit.
  param blades  : float [4.0, 60.0] = 28.0

  // Sun bearing in radians and warmth from 0 (neutral) to 1 (deep amber).
  param sun     : vec2 [0.0, 6.2831853] = vec2(0.9, 0.7)

  // Haze density per world unit.
  param haze    : float [0.0, 0.2] = 0.035

  // Strength of the lens flare.
  param flare   : float [0.0, 2.0] = 0.7

  fragment {
    // A loop of radius 40 round the origin, looking along its tangent.
    let a   = t * flight;
    let pos = vec2(cos(a), sin(a)) * 40.0;
    let yaw = -a;
    let bank = 0.06 * sin(t * 0.21);
    let gy0 = 2.4 * sin(pos.x * 0.035) * cos(pos.y * 0.03) + 0.6 * sin(pos.x * 0.11 + pos.y * 0.09);
    let o   = vec3(pos.x, gy0 + height + 0.6, pos.y);
    let rd  = rot_y(rot_x(rot_z(ray, bank), -0.1), yaw);

    var dep = 0.2;
    var hit = 0.0;
    var p   = o;
    var tip = 0.0;

    // Coarse march to the top of the grass layer, 0.22 above the hills.
    for i in 0..26 {
      p = o + rd * dep;
      let gap = p.y - 0.22 - 2.4 * sin(p.x * 0.035) * cos(p.z * 0.03) - 0.6 * sin(p.x * 0.11 + p.z * 0.09);
      if gap < 0.0 { hit = 1.0; }
      dep += max(gap * 0.6, 0.03 + dep * 0.03) * (1.0 - hit);
    }

    // Fine steps through the layer: blades are fine noise sheared by the wind,
    // and a ray stops where it passes under a blade's height.
    let fstep = 0.22 / max(-rd.y, 0.06) / 5.0;
    var inside = 0.0;
    for i in 0..5 {
      p = o + rd * dep;
      let hills = 2.4 * sin(p.x * 0.035) * cos(p.z * 0.03) + 0.6 * sin(p.x * 0.11 + p.z * 0.09);
      let bend = wind * 0.2 * sin(t * 1.7 + p.z * 0.5);
      let fur = clamp(0.5 + 0.8 * value_noise(vec3((p.x + bend) * blades, p.z * blades, 0.0)), 0.0, 1.0);
      if p.y - hills - fur * 0.22 < 0.0 { inside = 1.0; }
      tip = mix(tip, (p.y - hills) / 0.22, 1.0 - inside);
      dep += fstep * (1.0 - inside) * hit;
    }
    let fine = exp(-dep * 0.08);
    let tipv = clamp(mix(0.5, tip, fine), 0.0, 1.0);
    let sd   = normalize(vec3(cos(sun.x), 0.12, sin(sun.x)));
    let warm = mix(vec3(1.0, 0.95, 0.9), vec3(1.0, 0.62, 0.3), vec3(sun.y));
    let sky  = mix(vec3(0.55, 0.6, 0.68), vec3(0.28, 0.38, 0.55), vec3(clamp(rd.y * 3.0, 0.0, 1.0)));
    let sdot = max(dot(rd, sd), 0.0);
    let skyc = sky + warm * (pow(sdot, 400.0) * 6.0 + pow(sdot, 8.0) * 0.35);

    let lit  = 0.55 + 0.45 * max(dot(normalize(vec3(sd.x, 0.6, sd.z)), vec3(0.0, 1.0, 0.0)), 0.0);
    let grass = mix(vec3(0.03, 0.09, 0.02), vec3(0.35, 0.5, 0.18), vec3(tipv * tipv)) * lit * warm;
    let f    = 1.0 - exp(-dep * haze);
    let scene = mix(mix(skyc, grass, vec3(hit)), sky * 1.05, vec3(f * hit));

    // Flare: blobs along the line from the sun's screen position through the
    // centre, strongest when the camera faces the sun.
    let sc = rot_z(rot_x(rot_y(sd, a), 0.1), -bank);
    let face = max(-sc.z, 0.0);
    let ss = sc.xy / max(-sc.z, 0.05);
    let q  = ray.xy / max(-ray.z, 0.0001);
    var fl = 0.0;
    for k in 0..4 {
      let fk = float(k);
      let at = ss * (0.6 - fk * 0.55);
      let dd = length(q - at);
      let rad = 0.03 + fk * 0.035;
      fl += smoothstep(rad, rad * 0.6, dd) * 0.35 + exp(-abs(dd - rad * 1.8) * 60.0) * 0.2;
    }
    let flarec = warm * fl * flare * pow(face, 4.0);

    // Grade, vignette, letterbox.
    let g  = pow(scene + flarec, vec3(1.1)) * vec3(1.02, 1.0, 0.95);
    let v  = point_coord * 2.0 - 1.0;
    let vig = clamp(1.0 - dot(v, v) * 0.3, 0.0, 1.0);
    let box = step(0.11, point_coord.y) * step(point_coord.y, 0.89);
    color = vec4(g * vig * box, 1.0);
  }
}
