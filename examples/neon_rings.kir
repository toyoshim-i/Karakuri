// Glowing neon rings and discs orbiting the centre, each spinning, tilting
// into an ellipse and now and then snapping flat or flipping. Each one's red,
// green and blue pulse out of phase, and overlaps add toward white.
// Draws the whole frame and reads no geometry.
//
//     cargo run -p karakuri-cli -- --set examples/step_grid.kir,examples/neon_rings.kir

proc neon_rings {
  kind  L4
  blend additive

  // How many rings, floored; at most 8. Every third one is a filled disc.
  param count : float [1.0, 8.0] = 6.0

  // Orbit rate in turns per second, before each ring's own factor.
  param orbit : float [0.0, 1.0] = 0.12

  // Size of the sudden tilts: 0 tilts smoothly only, 1 snaps a ring through a
  // half turn on each jerk.
  param jerk  : float [0.0, 1.0] = 0.6

  // Ring radius, in frame half-heights.
  param ring  : float [0.05, 0.8] = 0.26

  // Colour pulses per second.
  param pulse : float [0.0, 4.0] = 0.5

  // Width of the glow around a ring's line, in frame half-heights.
  param glow  : float [0.001, 0.05] = 0.006

  fragment {
    // Isotropic frame coordinates from the camera ray: y runs -1..1 bottom to
    // top, x spans the width at the same scale. Assumes the built-in 60 degree
    // field of view.
    let fw = normalize(-eye);
    let rt = normalize(cross(fw, vec3(0.0, 1.0, 0.0)));
    let up = cross(rt, fw);
    let p  = vec2(dot(ray, rt), dot(ray, up)) / (dot(ray, fw) * 0.57735027);

    let n = floor(count);
    var c = vec3(0.0);
    for i in 0..8 {
      let fi = float(i);
      let h  = hash3(uint(i) * 1597u + 3u);
      let on = step(fi, n - 0.5);

      let oa = (h.x + t * orbit * (0.6 + 0.8 * h.y)) * 6.2831853;
      let orr = 0.25 + 0.6 * h.z;
      let ctr = vec2(cos(oa) * orr * 1.4, sin(oa) * orr);

      // Spin in the plane, and a tilt that squashes the ring to an ellipse.
      // The tilt jumps by `jerk` half turns whenever its step counter ticks.
      let sp = t * (0.5 + h.y) * 1.3 + h.x * 6.0;
      let jumps = floor(t * (0.3 + 0.4 * h.z) + h.y);
      let tl = t * (0.4 + 0.5 * h.x) + jumps * jerk * 2.2;
      let sq = cos(tl);
      let s2 = max(abs(sq), 0.15);
      let d0 = p - ctr;
      let cs = cos(sp);
      let sn = sin(sp);
      let q  = vec2(cs * d0.x + sn * d0.y, (cs * d0.y - sn * d0.x) / s2);
      let lq = max(length(q), 0.0001);
      let gr = length(vec2(q.x, q.y / s2)) / lq;
      let rr = ring * (0.6 + 0.8 * h.y);
      let dl = abs(lq - rr) / gr;

      let line = glow / (dl + glow * 0.3);
      let fill = step(1.5, float(i % 3)) * 0.25 * (1.0 - smoothstep(rr * 0.9, rr, lq));
      let col = vec3(0.5) + 0.5 * sin(vec3(0.0, 2.0943951, 4.1887902) + vec3(t * pulse * 6.2831853 * (0.7 + 0.6 * h.x) + fi));
      c += col * (line * 0.5 + fill) * on;
    }
    color = vec4(c, 1.0);
  }
}
