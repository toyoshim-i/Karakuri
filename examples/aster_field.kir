// A six-armed asterisk rasterised onto a 64-by-64 grid of small sprites, turning
// about a tilted axis. A ripple running out from the centre column pushes the
// sprites towards the eye by `lift`, and at the start of every `every` beats the
// sprites are thrown apart and fall back into place. Seed / 64 is the row and
// seed % 64 the column; cells outside the asterisk carry `size` 0.
// Ported from tmalib ext/mv/frame/astalight/main.js.
//
//     cargo run -p karakuri-cli -- --set examples/aster_field.kir,examples/aster_sprites.kir

proc aster_field {
  kind     L1
  topology points
  capacity [4096, 65536] = 4096

  // Radius of the asterisk in world units.
  param radius : float [0.5, 6.0] = 3.6

  // Width of an arm at the centre and its widening towards the tip, as
  // fractions of `radius`.
  param arm    : float [0.02, 0.5] = 0.13
  param flare  : float [0.0, 0.5] = 0.2

  // Turn rate about the tilted axis, in radians per second.
  param spin   : float [-3.0, 3.0] = 0.5

  // Height of the ripple towards the eye, in world units, and its speed in
  // radians per second.
  param lift   : float [0.0, 3.0] = 0.4
  param ripple : float [0.0, 12.0] = 3.0

  // How far the beat throws a sprite, and how many beats apart the throws are.
  param burst  : float [0.0, 6.0] = 1.2
  param every  : float [0.25, 16.0] = 4.0

  // Colour of the sprites.
  param ink    : vec3 [0.0, 2.0] = vec3(1.0, 0.13, 0.52)

  emit position, tint, size

  element {
    let row  = seed / 64u;
    let col  = seed % 64u;
    let step = 2.0 / 64.0;
    let g    = vec2((float(col) - 31.5) * step, (31.5 - float(row)) * step);

    let r      = length(g);
    let ang    = atan2(g.y, g.x);
    let across = abs(sin(ang * 3.0)) * r;
    var on     = 0.0;
    if r < 1.0 && across < arm + flare * r {
      on = 1.0;
    }
    if seed >= 4096u {
      on = 0.0;
    }

    let wave = 0.5 + 0.5 * sin(abs(g.x) * 12.0 - t * ripple);
    let bt   = max(beats, 0.0) / every;
    let k    = floor(bt);
    let into = (bt - k) * every;
    let dir  = hash3(seed * 37u + uint(k) * 7919u) * 2.0 - vec3(1.0);
    let fly  = into * exp(1.0 - into * 3.0) * 3.0;

    let p = vec3(g * radius, lift * wave) + dir * vec3(1.0, 1.0, 2.0) * (burst * fly);

    position = rot_axis(p, normalize(vec3(0.1, 0.2, 0.0)), t * spin);
    tint     = ink;
    size     = on * step * radius * 0.5;
  }
}
