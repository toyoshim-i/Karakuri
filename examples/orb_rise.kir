// Glowing discs rising through the xy plane from below the frame and wrapping
// back to the bottom when they leave the top, drifting a little sideways. Each
// disc throbs on its own rate and its edge softens and hardens as it does.
// `uv.x` carries the edge softness for the renderer.
//
//     cargo run -p karakuri-cli -- --set examples/orb_rise.kir,examples/flat_eye.kir,examples/soft_discs.kir

proc orb_rise {
  kind     L1
  topology points
  capacity [4, 1024] = 60

  // Rise speed in world units per second, before each disc's own factor.
  param rise    : float [0.0, 1.0] = 0.08

  // Smallest and largest disc diameter, in world units.
  param small   : float [0.01, 0.5] = 0.04
  param large   : float [0.05, 1.0] = 0.32

  // Throbs per second, before each disc's own factor.
  param flicker : float [0.0, 4.0] = 0.35

  // Colours at the two ends of the palette, in sRGB.
  param deep    : vec3 [0.0, 1.0] = vec3(0.05, 0.2, 1.0)
  param sea     : vec3 [0.0, 1.0] = vec3(0.0, 0.85, 0.6)

  emit position, tint, size, uv

  element {
    let h = hash3(seed);
    let k = hash3(seed + 101u);

    // Height wraps over [-1.5, 1.5]: the frame spans about [-1.1, 1.1] under
    // `flat_eye`, and the margin hides the jump.
    let y = fract(h.y + t * rise * (0.5 + k.x)) * 3.0 - 1.5;
    let x = (h.x * 2.0 - 1.0) * 2.1 + 0.15 * sin(t * 0.3 * (0.5 + k.y) + h.z * 6.2831853);
    position = vec3(x, y, 0.0);

    let ph = t * flicker * (0.5 + k.z) * 6.2831853 + h.z * 40.0;
    let on = 0.5 + 0.5 * sin(ph);
    let d  = mix(small, large, h.z * h.z);

    tint = srgb_to_linear(mix(deep, sea, vec3(k.y))) * (0.15 + 0.85 * on * on);
    size = d;
    uv   = vec2(0.15 + 0.7 * (0.5 + 0.5 * sin(ph * 0.5 + 1.3)), 0.0);
  }
}
