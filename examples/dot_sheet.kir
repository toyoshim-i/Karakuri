// A square grid of dots, shaded from blue through cyan and magenta to white
// across its two axes, tumbling about a tilted axis in its own plane.
// Ported from tmalib example/core/circles.html.
//
//     cargo run -p karakuri-cli -- --set examples/dot_sheet.kir,examples/plain_points.kir

proc dot_sheet {
  kind     L1
  topology points

  // The grid is the largest square that fits: 121 is 11 by 11.
  capacity [4, 65536] = 121

  // Half the grid's side, in world units.
  param half   : float [0.2, 4.0]  = 2.6

  // Turns per second about the tumble axis.
  param spin   : float [-2.0, 2.0] = 0.25

  // Direction of the tumble axis.
  param axis   : vec3 [-1.0, 1.0]  = vec3(0.1, 0.15, 0.0)

  emit position, tint

  element {
    let side = max(floor(sqrt(float(capacity))), 2.0);
    let i    = float(seed) % side;
    let j    = floor(float(seed) / side);
    let u    = i / (side - 1.0);
    let v    = j / (side - 1.0);

    let p  = vec3((u * 2.0 - 1.0) * half, (v * 2.0 - 1.0) * half, 0.0);
    let ax = normalize(axis + vec3(0.0, 0.0, 0.0001));

    let used = j < side;
    if used {
      position = rot_axis(p, ax, t * spin * 6.2831853);
      tint     = srgb_to_linear(vec3(u, v, 1.0));
    } else {
      position = vec3(0.0);
      tint     = vec3(0.0);
    }
  }
}
