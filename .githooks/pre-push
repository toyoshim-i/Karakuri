#!/bin/sh
# The full suite, on a tag push and on nothing else.
#
# **A tag is the deploy; a branch push is not.** Pushing a branch is part of
# working — backing up, moving between machines, opening something for review —
# and a gate there asks "is this good" at a moment nobody was claiming it was.
# Tagging is the moment somebody is claiming it, and the moment a release
# pipeline would pick it up, so that is where everything runs.
#
# What guards the ordinary commit is `pre-commit`, which is fast on purpose. In
# between, running the whole thing by hand is the right move whenever the answer
# matters — before a tag, after a refactor, when something feels off:
#
#     cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace
#
# The tests need a GPU. There is no skip: a test that passes by not running is
# worse than one that fails, which is what every GPU test in this workspace says
# for itself — eight of them used to print and return instead, and were made to
# panic when `--skip gpu::` gave an adapterless machine a better answer than a
# green run that measured nothing.
#
# **That filter is for the working day, not for here.** Every GPU test lives
# under a `mod gpu`, so `cargo test -- --skip gpu::` runs the ~70% of the suite
# that needs no device in about three seconds — which is the right thing to run
# while working and the wrong thing to run at a tag, because a gate that quietly
# checks nothing is the same claim one level up.
set -e

# The refs being pushed arrive on stdin, one line each. **Reading them is what
# makes this selective** — the previous version took no input, so it could not
# tell a tag from a branch and ran everything for both.
tags=""
pushing_main=""

while read -r local_ref local_sha remote_ref remote_sha; do
    # A deletion pushes the null sha and carries nothing to test.
    case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;
    esac

    case "$local_ref" in
        refs/tags/*)
            case "$local_sha" in *[!0]*) tags="$tags ${local_ref#refs/tags/}" ;; esac
            ;;
        refs/heads/main)
            pushing_main="true"
            ;;
    esac

    case "$remote_ref" in
        refs/heads/main)
            pushing_main="true"
            ;;
    esac
done

check_wasm_deploy() {
    echo "pre-push: checking wasm clippy (karakuri-web)"
    cargo clippy --quiet --target wasm32-unknown-unknown -p karakuri-web --all-targets -- -D warnings

    echo "pre-push: checking wasm workspace build"
    cargo build --quiet --target wasm32-unknown-unknown

    echo "pre-push: checking wasm demo build (GitHub Pages deploy gate)"
    if command -v trunk >/dev/null 2>&1; then
        echo "pre-push: trunk build crates/karakuri-web/index.html --release"
        trunk build crates/karakuri-web/index.html --release --dist dist/demo --public-url /Karakuri/demo/
    else
        echo "pre-push: warning: 'trunk' not found on PATH. Falling back to cargo build."
        echo "pre-push: to test exact deploy build locally, install trunk (e.g. cargo install trunk)"
        cargo build --target wasm32-unknown-unknown -p karakuri-web
    fi
}


if [ -n "$tags" ]; then
    echo "pre-push: tag$tags — running the full suite"

    echo "pre-push: cargo fmt --check"
    cargo fmt --check

    echo "pre-push: cargo clippy --workspace --all-targets"
    cargo clippy --quiet --workspace --all-targets -- -D warnings

    echo "pre-push: cargo test --workspace"
    cargo test --quiet --workspace

    check_wasm_deploy

    echo "pre-push: ok"
    exit 0
fi

if [ "$pushing_main" = "true" ]; then
    check_wasm_deploy
    echo "pre-push: ok"
    exit 0
fi

