#!/bin/sh
# Refuse a commit whose Rust is not what `cargo fmt` would write, and warn —
# without refusing anything — the commit that pushes a file's staged content
# past 1000 lines for the first time. See ADR-0345 for why the second check
# never fails a commit.
#
# **It checks the staged content, not the working tree.** Those differ whenever
# something is half-finished on disk, and a hook that reads the disk either
# blocks a good commit for an unrelated edit or passes a bad one that was fixed
# after staging. What is being committed is what has to be right.
#
# Why formatting is the only thing that can fail this hook, and where the
# tests went, is at the bottom of this file.
set -e

files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.rs')
[ -n "$files" ] || exit 0

# **A hook's PATH is not the login shell's.** A GUI client, a scheduled build or
# another machine's default shell can all leave `rustfmt` unreachable here while
# `cargo fmt` works perfectly in a terminal. Said before anything is checked,
# because the alternative is what this hook used to do: fold `rustfmt`'s stderr
# in with its diff and report `not formatted:` against a file that is formatted
# exactly right. That cost a operator on another machine real time, and the
# message sent them looking at their code.
if ! command -v rustfmt >/dev/null 2>&1; then
    echo "rustfmt is not on this hook's PATH, so nothing was checked."
    echo
    echo "this is not a claim about your code. a hook runs with a shell that may"
    echo "not have read your profile — try \`rustup component add rustfmt\`, and"
    echo "if \`rustfmt --version\` works in a terminal but not here, the PATH is"
    echo "what differs."
    exit 1
fi

bad=""
noise=""
complained=$(mktemp)
trap 'rm -f "$complained"' EXIT
for f in $files; do
    # **Judged by output and not by exit code.** `rustfmt --check` reading stdin
    # prints the diff and still exits 0 — which is not what it does for a named
    # file, and is why the first version of this hook let an unformatted file
    # straight through while looking like it had checked it.
    #
    # `--edition` matters too: without it rustfmt assumes 2015 and misparses
    # `async` and `dyn`, so a clean file reads as an error.
    #
    # **stdout and stderr are kept apart**, because they answer different
    # questions: the diff on stdout means the file is not formatted, and
    # anything on stderr means `rustfmt` could not do the job. Merging them
    # makes every failure read as the first one.
    : > "$complained"
    if [ -n "$(git show ":$f" | rustfmt --edition 2021 --check 2>"$complained")" ]; then
        bad="$bad $f"
    fi
    if [ -s "$complained" ]; then
        noise="$noise$f: $(head -c 400 "$complained")
"
    fi
done

if [ -n "$noise" ]; then
    echo "rustfmt could not check some of what is staged, and said:"
    printf '%s' "$noise"
    echo "this is rustfmt's own complaint, not a formatting difference."
    exit 1
fi

if [ -n "$bad" ]; then
    echo "not formatted:"
    for f in $bad; do echo "  $f"; done
    echo
    echo "run \`cargo fmt\`, stage the result, and commit again."
    echo "\`git commit --no-verify\` skips this, and there is no reason to."
    exit 1
fi

# **A file crossing 1000 lines is worth one printout, on the commit that does
# it, and nothing on every commit after** (ADR-0345). Comparing against `HEAD`
# rather than just checking the staged size is what makes this fire once: a
# file already over the line stays quiet on every later touch, because the
# fact was already said the day it became true. `2>/dev/null` on the `HEAD`
# read is a new file, which counts as crossing from zero.
threshold=1000
crossed=""
for f in $files; do
    after=$(git show ":$f" | wc -l | tr -d ' ')
    before=$(git show "HEAD:$f" 2>/dev/null | wc -l | tr -d ' ')
    [ -n "$before" ] || before=0
    if [ "$after" -gt "$threshold" ] && [ "$before" -le "$threshold" ]; then
        crossed="$crossed  $f ($before -> $after lines)
"
    fi
done

if [ -n "$crossed" ]; then
    echo "just crossed $threshold lines:"
    printf '%s' "$crossed"
    echo "not a reason to stop — see docs/adr/0345-a-file-that-crosses-1000-lines-gets-a-nudge-not-a-gate.md"
    echo "for why this is a nudge and not a gate. Worth a look before it grows further."
fi

# **No tests here, and that is a decision rather than an omission.** This
# workspace has nearly nine hundred of them and most want a GPU, so running any
# fixed subset on every commit spends minutes answering a question nobody asked
# at a moment nobody chose. A commit is a git lifecycle event; it does not know
# what changed in a way that tells you what is worth running.
#
# What replaces it is deliberate: whoever makes a change names the smallest
# suite that answers it and runs that, and the whole thing runs once at a
# boundary — before a tag, after a refactor, whenever the answer matters.
# `pre-push` runs it for a tag; see there.
exit 0
